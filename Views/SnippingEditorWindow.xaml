<Window x:Class="StreamGuard.Views.SnippingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:StreamGuard.Localization"
        Title="{loc:Translate Key=SnippingEditor.Title}"
        Width="1040" Height="700"
        MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        Topmost="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="EditorIconPath" TargetType="Path">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EditorBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorPrimaryBtn" TargetType="Button" BasedOn="{StaticResource EditorBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentNeonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorModeRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorToggleBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentTealBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TealBorderBrush}"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Primary Tools (Crop, Blur, Rotate, Flip, History) -->
        <Border Grid.Row="0" Background="{DynamicResource CardSurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="RadioCropMode" GroupName="EditorTool" Style="{StaticResource EditorModeRadio}" IsChecked="True" Margin="0,0,6,4" Checked="ToolMode_Changed">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Data="M6,2 L6,18 L22,18 M2,6 L18,6 L18,22"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.ModeCrop}" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="RadioBlurMode" GroupName="EditorTool" Style="{StaticResource EditorModeRadio}" Margin="0,0,6,4" Checked="ToolMode_Changed">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.ModeBlurRegion}" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <Button x:Name="BtnApplyCrop" Style="{StaticResource EditorPrimaryBtn}" Margin="0,0,10,4" IsEnabled="False" Click="BtnApplyCrop_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Data="M4,12 L9,17 L20,6"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.ApplyCrop}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Height="22" Background="{DynamicResource BorderBrush2}" Margin="0,0,10,4"/>

                <Button x:Name="BtnRotateLeft" Style="{StaticResource EditorBtn}" Margin="0,0,4,4" Click="BtnRotateLeft_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Data="M3,12 A9,9 0 1,0 6,5.5 M3,4 L3,9 L8,9"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.RotateLeft}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRotateRight" Style="{StaticResource EditorBtn}" Margin="0,0,4,4" Click="BtnRotateRight_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Data="M21,12 A9,9 0 1,1 18,5.5 M21,4 L21,9 L16,9"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.RotateRight}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnFlipH" Style="{StaticResource EditorBtn}" Margin="0,0,4,4" Click="BtnFlipH_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Data="M12,3 L12,21 M8,7 L3,12 L8,17 Z M16,7 L21,12 L16,17 Z"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.FlipHorizontal}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnFlipV" Style="{StaticResource EditorBtn}" Margin="0,0,10,4" Click="BtnFlipV_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Data="M3,12 L21,12 M7,8 L12,3 L17,8 Z M7,16 L12,21 L17,16 Z"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.FlipVertical}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Height="22" Background="{DynamicResource BorderBrush2}" Margin="0,0,10,4"/>

                <Button x:Name="BtnUndo" Style="{StaticResource EditorBtn}" Margin="0,0,4,4" IsEnabled="False" Click="BtnUndo_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Data="M9,14 L4,9 L9,4 M4,9 L14,9 A6,6 0 0,1 14,21 L11,21"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.Undo}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRedo" Style="{StaticResource EditorBtn}" Margin="0,0,4,4" IsEnabled="False" Click="BtnRedo_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Data="M15,14 L20,9 L15,4 M20,9 L10,9 A6,6 0 0,0 10,21 L13,21"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.Redo}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnReset" Style="{StaticResource EditorBtn}" Margin="0,0,0,4" Click="BtnReset_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Data="M3,12 A9,9 0 1,1 7,18.5 M3,20 L3,15 L8,15"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.Reset}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Row 1: Resize, Blur Controls & Magnifier/Zoom -->
        <Border Grid.Row="1" Background="{DynamicResource CardSurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Translate Key=SnippingEditor.ResizeLabel}" Foreground="{DynamicResource TextDimBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,2"/>
                <TextBox x:Name="TxtResizeWidth" Style="{StaticResource EditorInput}" Margin="0,0,4,2" TextChanged="TxtResizeWidth_TextChanged"/>
                <TextBlock Text="×" Foreground="{DynamicResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,2"/>
                <TextBox x:Name="TxtResizeHeight" Style="{StaticResource EditorInput}" Margin="0,0,6,2" TextChanged="TxtResizeHeight_TextChanged"/>
                <CheckBox x:Name="ChkLockAspect" IsChecked="True" Foreground="{DynamicResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,2"
                          Content="{loc:Translate Key=SnippingEditor.LockAspect}"/>
                <Button x:Name="BtnScale75" Style="{StaticResource EditorBtn}" Padding="7,4" Height="28" Margin="0,0,4,2" Content="75%" Click="BtnScale75_Click"/>
                <Button x:Name="BtnScale50" Style="{StaticResource EditorBtn}" Padding="7,4" Height="28" Margin="0,0,4,2" Content="50%" Click="BtnScale50_Click"/>
                <Button x:Name="BtnApplyResize" Style="{StaticResource EditorBtn}" Height="28" Margin="0,0,10,2" Click="BtnApplyResize_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Width="12" Height="12" Data="M15,3 L21,3 L21,9 M9,21 L3,21 L3,15 M21,3 L14,10 M3,21 L10,14"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.ApplyResize}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Height="22" Background="{DynamicResource BorderBrush2}" Margin="0,0,10,2"/>

                <TextBlock Text="{loc:Translate Key=SnippingEditor.BlurStrength}" Foreground="{DynamicResource TextDimBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,2"/>
                <Slider x:Name="SliderBlurStrength" Minimum="4" Maximum="32" Value="14" Width="80" VerticalAlignment="Center" Margin="0,0,8,2" IsSnapToTickEnabled="True" TickFrequency="2"/>
                <CheckBox x:Name="ChkMosaicBlur" IsChecked="True" Foreground="{DynamicResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,2"
                          Content="{loc:Translate Key=SnippingEditor.MosaicMode}"/>
                <Button x:Name="BtnBlurAll" Style="{StaticResource EditorBtn}" Height="28" Margin="0,0,10,2"
                        ToolTip="{loc:Translate Key=SnippingEditor.BlurAllTooltip}" Click="BtnBlurAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Width="12" Height="12" Data="M12,2 C12,2 6,9 6,14 A6,6 0 0,0 18,14 C18,9 12,2 12,2 Z"/>
                        <TextBlock x:Name="TxtBlurAllLabel" Text="{loc:Translate Key=SnippingEditor.BlurAll}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Height="22" Background="{DynamicResource BorderBrush2}" Margin="0,0,10,2"/>

                <!-- Zoom & Magnifier Controls -->
                <Button x:Name="BtnZoomOut" Style="{StaticResource EditorBtn}" Height="28" Padding="7,4" Margin="0,0,4,2"
                        ToolTip="{loc:Translate Key=SnippingEditor.ZoomOutTip}" Click="BtnZoomOut_Click">
                    <Path Style="{StaticResource EditorIconPath}" Width="13" Height="13" Margin="0" Data="M11,4 A7,7 0 1,0 11,18 A7,7 0 1,0 11,4 Z M21,21 L16.2,16.2 M8,11 L14,11"/>
                </Button>
                <Button x:Name="BtnZoomReset" Style="{StaticResource EditorBtn}" Height="28" Padding="8,4" Margin="0,0,4,2"
                        ToolTip="{loc:Translate Key=SnippingEditor.ZoomResetTip}" Click="BtnZoomReset_Click">
                    <TextBlock x:Name="TxtZoomPercent" Text="100%" FontSize="11" FontWeight="SemiBold"/>
                </Button>
                <Button x:Name="BtnZoomIn" Style="{StaticResource EditorBtn}" Height="28" Padding="7,4" Margin="0,0,6,2"
                        ToolTip="{loc:Translate Key=SnippingEditor.ZoomInTip}" Click="BtnZoomIn_Click">
                    <Path Style="{StaticResource EditorIconPath}" Width="13" Height="13" Margin="0" Data="M11,4 A7,7 0 1,0 11,18 A7,7 0 1,0 11,4 Z M21,21 L16.2,16.2 M8,11 L14,11 M11,8 L11,14"/>
                </Button>
                <ToggleButton x:Name="ToggleMagnifier" Style="{StaticResource EditorToggleBtn}" Margin="0,0,0,2"
                              ToolTip="{loc:Translate Key=SnippingEditor.MagnifierTip}"
                              Checked="ToggleMagnifier_Changed" Unchecked="ToggleMagnifier_Changed">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Width="12" Height="12" Data="M11,4 A7,7 0 1,0 11,18 A7,7 0 1,0 11,4 Z M21,21 L16.2,16.2"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.Magnifier}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
            </WrapPanel>
        </Border>

        <!-- Row 2: Zoomable Image Viewport & Magnifier Lens -->
        <Border Grid.Row="2" Background="{DynamicResource EditorCanvasBgBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="6">
            <Grid>
                <ScrollViewer x:Name="ImageScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                              SizeChanged="ImageScrollViewer_SizeChanged">
                    <Grid x:Name="ZoomContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
                               MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                               MouseMove="PreviewImage_MouseMove"
                               MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp"
                               MouseLeave="PreviewImage_MouseLeave"
                               MouseRightButtonDown="PreviewImage_MouseRightButtonDown"
                               MouseRightButtonUp="PreviewImage_MouseRightButtonUp"
                               Cursor="Cross"/>
                        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                            <Rectangle x:Name="SelectionRectVisual"
                                       Visibility="Collapsed"
                                       Stroke="#38bdf8"
                                       StrokeThickness="2"
                                       StrokeDashArray="4 2"
                                       Fill="#3338bdf8"/>
                        </Canvas>
                    </Grid>
                </ScrollViewer>

                <!-- Floating 2.5x Magnifier Loupe -->
                <Canvas x:Name="LoupeCanvas" IsHitTestVisible="False" ClipToBounds="True">
                    <Border x:Name="LoupeBorder"
                            Width="148" Height="148"
                            CornerRadius="74"
                            BorderBrush="#38bdf8"
                            BorderThickness="2"
                            Visibility="Collapsed">
                        <Grid ClipToBounds="True">
                            <Ellipse Width="144" Height="144">
                                <Ellipse.Fill>
                                    <VisualBrush x:Name="LoupeVisualBrush" ViewboxUnits="Absolute" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- Center crosshair inside loupe -->
                            <Path Stroke="#9938bdf8" StrokeThickness="1" Data="M72,56 L72,88 M56,72 L88,72"/>
                        </Grid>
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <!-- Row 3: Status / Warning & Footer Actions -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtEditorInfo" Foreground="{DynamicResource TextDimBrush}" FontSize="11.5"/>
                <TextBlock x:Name="TxtEditorWarning" Foreground="{DynamicResource WarningTextBrush}" FontSize="11.5" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Style="{StaticResource EditorBtn}" Margin="0,0,8,0" Padding="12,5" Click="BtnCancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Data="M6,6 L18,18 M18,6 L6,18"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.Cancel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnCopyOnly" Style="{StaticResource EditorBtn}" Margin="0,0,8,0" Padding="12,5" Click="BtnCopyOnly_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Data="M9,4 H17 A2,2 0 0,1 19,6 V16 M5,8 H13 A2,2 0 0,1 15,10 V19 A2,2 0 0,1 13,21 H5 A2,2 0 0,1 3,19 V10 A2,2 0 0,1 5,8 Z"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.CopyOnly}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSave" Style="{StaticResource EditorPrimaryBtn}" Padding="14,5" Click="BtnSave_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource EditorIconPath}" Data="M5,3 H16 L20,7 V19 A2,2 0 0,1 18,21 H5 A2,2 0 0,1 3,19 V5 A2,2 0 0,1 5,3 Z M8,3 V8 H15 V3 M7,21 V14 H16 V21"/>
                        <TextBlock Text="{loc:Translate Key=SnippingEditor.Save}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
