<Application x:Class="StreamGuard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary xmlns:ui="clr-namespace:StreamGuard.Controls">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Driver%20Booster;component/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Geometry x:Key="UiIconShield">M12,2 L3,6 V12 C3,17 7,21 12,23 C17,21 21,17 21,12 V6 Z M8,12 L11,15 L16,9</Geometry>
            <Geometry x:Key="UiIconWindows">M3,3 H21 V21 H3 Z M3,8 H21 M8,8 V21</Geometry>
            <Geometry x:Key="UiIconCaptions">M3,4 H21 V18 H15 L11,22 V18 H3 Z M6,9 H10 M6,13 H10 M14,9 H18 M14,13 H18</Geometry>
            <Geometry x:Key="UiIconRecover">M4,9 A8,8 0 1 1 4,17 M4,3 V9 H10 M12,7 V12 L15,14</Geometry>
            <Geometry x:Key="UiIconPlay">M7,3 L21,12 L7,21 Z</Geometry>
            <Geometry x:Key="UiIconPause">M8,3 V21 M16,3 V21</Geometry>
            <Geometry x:Key="UiIconStop">M5,5 H19 V19 H5 Z</Geometry>
            <Geometry x:Key="UiIconEye">M2,12 Q12,-2 22,12 Q12,26 2,12 Z M16,12 A4,4 0 1 0 8,12 A4,4 0 1 0 16,12</Geometry>
            <Geometry x:Key="UiIconCopy">M8,8 H21 V22 H8 Z M16,8 V2 H2 V16 H8</Geometry>
            <Geometry x:Key="UiIconFolder">M2,6 H9 L12,9 H22 V21 H2 Z M2,9 V3 H9 L12,6 H20 V9</Geometry>
            <Geometry x:Key="UiIconRefresh">M3,10 A9,9 0 1 1 5,18 M3,3 V10 H10</Geometry>
            <Geometry x:Key="UiIconCheck">M4,12 L9,17 L20,6</Geometry>
            <Geometry x:Key="UiIconAlert">M12,2 L23,22 H1 Z M12,8 V14 M12,18 H12.1</Geometry>
            <Geometry x:Key="UiIconPlus">M12,3 V21 M3,12 H21</Geometry>
            <Geometry x:Key="UiIconKeyboard">M2,5 H22 V19 H2 Z M6,9 H6.1 M10,9 H10.1 M14,9 H14.1 M18,9 H18.1 M6,12 H6.1 M10,12 H10.1 M14,12 H14.1 M18,12 H18.1 M7,16 H17</Geometry>
            <Geometry x:Key="UiIconLanguage">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M2,12 H22 M12,2 C6,7 6,17 12,22 M12,2 C18,7 18,17 12,22</Geometry>
            <Geometry x:Key="UiIconAudio">M3,10 V14 H7 L12,19 V5 L7,10 Z M16,8 Q21,12 16,16 M19,4 Q27,12 19,20</Geometry>
            <Geometry x:Key="UiIconDownload">M12,2 V16 M6,10 L12,16 L18,10 M3,17 V22 H21 V17</Geometry>
            <Geometry x:Key="UiIconSearch">M16,10 A6,6 0 1 0 4,10 A6,6 0 1 0 16,10 M14.5,14.5 L21,21</Geometry>
            <Geometry x:Key="UiIconLock">M5,10 H19 V22 H5 Z M8,10 V6 A4,4 0 1 1 16,6 V10 M12,15 V18</Geometry>
            <Geometry x:Key="UiIconCrop">M6,2 V18 H22 M2,6 H18 V22</Geometry>
            <Geometry x:Key="UiIconClose">M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z</Geometry>
            <Geometry x:Key="UiIconDelete">M3,6 H21 M8,6 V4 H16 V6 M19,6 V20 A2,2 0 0 1 17,22 H7 A2,2 0 0 1 5,20 V6 M10,11 V17 M14,11 V17</Geometry>
            <Geometry x:Key="UiIconCpu">M6,4 H18 A2,2 0 0 1 20,6 V18 A2,2 0 0 1 18,20 H6 A2,2 0 0 1 4,18 V6 A2,2 0 0 1 6,4 Z M9,9 H15 V15 H9 Z M9,1 V4 M12,1 V4 M15,1 V4 M9,20 V23 M12,20 V23 M15,20 V23 M1,9 H4 M1,12 H4 M1,15 H4 M20,9 H23 M20,12 H23 M20,15 H23</Geometry>
            <Style x:Key="UiStrokeIcon" TargetType="Path">
                <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/>
                <Setter Property="Stretch" Value="Uniform"/><Setter Property="StrokeThickness" Value="1.7"/>
                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="ui:SectionHeader">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IconBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BadgeBackground" Value="{DynamicResource SectionBadgeBgBrush}"/>
                <Setter Property="BadgeBorder" Value="{DynamicResource SectionBadgeBorderBrush}"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="ui:SectionHeader">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="10" Background="{TemplateBinding BadgeBackground}" BorderBrush="{TemplateBinding BadgeBorder}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Top">
                                <Path Data="{TemplateBinding Icon}" Style="{StaticResource UiStrokeIcon}" Stroke="{TemplateBinding IconBrush}" Width="17" Height="17" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="Description" Text="{TemplateBinding Subtitle}" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="Subtitle" Value=""><Setter TargetName="Description" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
            <Style x:Key="UiLabelChip" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ChipBgBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="7,3"/><Setter Property="Margin" Value="0,0,6,4"/>
            </Style>
            <DataTemplate x:Key="ActionLabelContent">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Path x:Name="ActionGlyph" Data="{Binding Path=(ui:Icon.Data), RelativeSource={RelativeSource AncestorType=Button}}"
                          Style="{StaticResource UiStrokeIcon}" Width="12" Height="12" Margin="0,0,6,0"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <ContentPresenter Grid.Column="1" Content="{Binding}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Path=(ui:Icon.Data), RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Null}">
                        <Setter TargetName="ActionGlyph" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource AncestorType=Button}}" Value="">
                        <Setter TargetName="ActionGlyph" Property="Margin" Value="0"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="CaptionAudioMeter" TargetType="ProgressBar">
                <Setter Property="Background" Value="{DynamicResource MeterTrackBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════════════════════════════════════════════════════════
                 2. MODERN FLUENT SCROLLBAR
                 ══════════════════════════════════════════════════════════════ -->
            <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border x:Name="ThumbBorder" CornerRadius="3" Background="{DynamicResource ScrollThumbBgBrush}" Margin="1"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="Width" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="true">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════════════════════════════════════════════════════════
                 3. MODERN FLUENT TOGGLE SWITCH
                 ══════════════════════════════════════════════════════════════ -->
            <Style x:Key="ToggleStyle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="40" Height="22" Background="Transparent" VerticalAlignment="Center">
                                <Border x:Name="TrackOff" CornerRadius="11" Background="{DynamicResource ToggleTrackOffBgBrush}" BorderBrush="{DynamicResource ToggleTrackOffBorderBrush}" BorderThickness="1"/>
                                <Border x:Name="TrackOn" CornerRadius="11" Background="{DynamicResource ShieldActiveGradient}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" Opacity="0"/>
                                <Ellipse x:Name="Thumb" Width="14" Height="14"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="#64748b" Margin="4,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                <ColorAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#FFFFFF" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                <ColorAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#64748b" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter TargetName="Thumb" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform X="18" Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="TrackOn" Property="Opacity" Value="1"/>
                                    <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TrackOff" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════════════════════════════════════════════════════════
                 4. MODERN CHECKBOX
                 ══════════════════════════════════════════════════════════════ -->
            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="CheckBorder" Width="18" Height="18" CornerRadius="5"
                                        Background="{DynamicResource CheckBoxBgBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1.5"
                                        Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path x:Name="CheckMark" Data="M 3 8 L 7 12 L 13 4"
                                          Stroke="#ffffff" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                        <Style TargetType="AccessText"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════════════════════════════════════════════════════════
                 5. MODERN BUTTONS
                 ══════════════════════════════════════════════════════════════ -->
            <Style x:Key="BaseButton" TargetType="Button">
                <Setter Property="ContentTemplate" Value="{StaticResource ActionLabelContent}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource CardActiveBrush}"/>
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#ffffff"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.3" Color="#6366f1"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource DangerHoverBgBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource GhostHoverBgBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource GhostPressedBgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Window Caption Buttons (Minimize/Maximize/Close) -->
            <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBorder" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBorder" Property="Background" Value="#e11d48"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════════════════════════════════════════════════════════
                 6. SIDEBAR NAVIGATION ITEM (RadioButton)
                 ══════════════════════════════════════════════════════════════ -->
            <Style x:Key="NavTabRadio" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Margin" Value="8,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="12,9">
                                <Grid>
                                    <!-- Left active indicator pill -->
                                    <Border x:Name="ActivePill" Width="3" Height="16" CornerRadius="1.5"
                                            Background="{Binding Path=(ui:NavTab.AccentBrush), RelativeSource={RelativeSource TemplatedParent}, FallbackValue='#818cf8'}"
                                            HorizontalAlignment="Left" Visibility="Collapsed" Margin="-8,0,0,0"/>
                                    <ContentPresenter VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource NavTabHoverBgBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{Binding Path=(ui:NavTab.ActiveBackgroundBrush), RelativeSource={RelativeSource TemplatedParent}, FallbackValue='#192033'}"/>
                                    <Setter TargetName="ActivePill" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="{DynamicResource NavTabSelectedTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════════════════════════════════════════════════════════
                 7. MODERN TEXTBOX
                 ══════════════════════════════════════════════════════════════ -->
            <Style x:Key="ModernTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="TextBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TextBorder" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="TextBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="TextBorder" Property="Background" Value="{DynamicResource InputFocusBgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════════════════════════════════════════════════════════
                 8. LISTBOX ITEM
                 ══════════════════════════════════════════════════════════════ -->
            <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListItemHoverBgBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListItemSelectedBgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compatibility Styles -->
            <Style x:Key="TabNavButton" TargetType="RadioButton" BasedOn="{StaticResource NavTabRadio}"/>
            <Style x:Key="DarkComboBoxItem" TargetType="{x:Type ComboBoxItem}">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PopupBgBrush}"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PopupHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PopupSelectedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
