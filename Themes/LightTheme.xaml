<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core Surfaces (Fluent 2 Crisp Light Palette) -->
    <SolidColorBrush x:Key="BgBrush" Color="#f1f5f9"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#e7eef7"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#cbd5e1"/>
    <SolidColorBrush x:Key="CardBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#f8fafc"/>
    <SolidColorBrush x:Key="CardActiveBrush" Color="#e2e8f0"/>
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#f8fafc"/>
    <SolidColorBrush x:Key="CardSurfaceSubtleBrush" Color="#eef2f6"/>
    <SolidColorBrush x:Key="CardSurfaceElevatedBrush" Color="#f1f5f9"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="#cbd5e1"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#94a3b8"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#4f46e5"/>

    <!-- Inputs, Popups & Badges -->
    <SolidColorBrush x:Key="InputBgBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="InputFocusBgBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="PopupBgBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="PopupHoverBrush" Color="#e2e8f0"/>
    <SolidColorBrush x:Key="PopupSelectedBrush" Color="#dbeafe"/>
    <SolidColorBrush x:Key="ChipBgBrush" Color="#e2e8f0"/>
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#cbd5e1"/>
    <SolidColorBrush x:Key="SectionBadgeBgBrush" Color="#e0e7ff"/>
    <SolidColorBrush x:Key="SectionBadgeBorderBrush" Color="#c7d2fe"/>
    <SolidColorBrush x:Key="BadgePillBgBrush" Color="#eef2ff"/>
    <SolidColorBrush x:Key="BadgePillBorderBrush" Color="#c7d2fe"/>
    <SolidColorBrush x:Key="IndigoCardBgBrush" Color="#eef2ff"/>
    <SolidColorBrush x:Key="IndigoCardBorderBrush" Color="#c7d2fe"/>

    <!-- Controls & Navigation -->
    <SolidColorBrush x:Key="ToggleTrackOffBgBrush" Color="#cbd5e1"/>
    <SolidColorBrush x:Key="ToggleTrackOffBorderBrush" Color="#94a3b8"/>
    <SolidColorBrush x:Key="ToggleThumbOffBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="CheckBoxBgBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="NavTabHoverBgBrush" Color="#dbe4f0"/>
    <SolidColorBrush x:Key="NavTabSelectedTextBrush" Color="#0f172a"/>
    <SolidColorBrush x:Key="GhostHoverBgBrush" Color="#e2e8f0"/>
    <SolidColorBrush x:Key="GhostPressedBgBrush" Color="#cbd5e1"/>
    <SolidColorBrush x:Key="ListItemHoverBgBrush" Color="#f1f5f9"/>
    <SolidColorBrush x:Key="ListItemSelectedBgBrush" Color="#e0e7ff"/>
    <SolidColorBrush x:Key="ScrollThumbBgBrush" Color="#cbd5e1"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6366f1"/>
    <SolidColorBrush x:Key="MeterTrackBgBrush" Color="#e2e8f0"/>

    <!-- Accents & Gradients -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4f46e5"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#4338ca"/>
    <SolidColorBrush x:Key="AccentNeonBrush" Color="#6366f1"/>
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#0891b2"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#3730a3"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4f46e5" Offset="0.0"/>
        <GradientStop Color="#7c3aed" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShieldActiveGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10b981" Offset="0.0"/>
        <GradientStop Color="#059669" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#e11d48" Offset="0.0"/>
        <GradientStop Color="#be123c" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Status Indicators (High-contrast Light Palette) -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#047857"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#ecfdf5"/>
    <SolidColorBrush x:Key="SuccessBgSubtleBrush" Color="#d1fae5"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#6ee7b7"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#e11d48"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#be123c"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#fff1f2"/>
    <SolidColorBrush x:Key="DangerBgSubtleBrush" Color="#ffe4e6"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#fda4af"/>
    <SolidColorBrush x:Key="DangerHoverBgBrush" Color="#fecdd3"/>

    <SolidColorBrush x:Key="WarningBrush" Color="#d97706"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#b45309"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#fffbeb"/>
    <SolidColorBrush x:Key="WarningBgSubtleBrush" Color="#fef3c7"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#fcd34d"/>

    <SolidColorBrush x:Key="InfoBrush" Color="#0284c7"/>
    <SolidColorBrush x:Key="InfoTextBrush" Color="#0369a1"/>
    <SolidColorBrush x:Key="BlueBgSubtleBrush" Color="#e0f2fe"/>
    <SolidColorBrush x:Key="BlueBorderBrush" Color="#7dd3fc"/>

    <SolidColorBrush x:Key="CyanBgSubtleBrush" Color="#cffafe"/>
    <SolidColorBrush x:Key="CyanBorderBrush" Color="#67e8f9"/>

    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#9333ea"/>
    <SolidColorBrush x:Key="PurpleBgSubtleBrush" Color="#f3e8ff"/>
    <SolidColorBrush x:Key="PurpleBorderBrush" Color="#d8b4fe"/>

    <SolidColorBrush x:Key="AccentTealBrush" Color="#0d9488"/>
    <SolidColorBrush x:Key="TealBgSubtleBrush" Color="#ccfbf1"/>
    <SolidColorBrush x:Key="TealBorderBrush" Color="#5eead4"/>

    <SolidColorBrush x:Key="IndigoBgSubtleBrush" Color="#e0e7ff"/>
    <SolidColorBrush x:Key="IndigoBorderBrush" Color="#a5b4fc"/>

    <!-- Typography & Overlays -->
    <SolidColorBrush x:Key="TextBrush" Color="#0f172a"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748b"/>
    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#990f172a"/>
    <SolidColorBrush x:Key="ModalSurfaceBrush" Color="#f7ffffff"/>
    <SolidColorBrush x:Key="EditorCanvasBgBrush" Color="#e2e8f0"/>

    <!-- Toast Card Tokens -->
    <SolidColorBrush x:Key="ToastTextBrush" Color="#0f172a"/>
    <SolidColorBrush x:Key="ToastCloseStrokeBrush" Color="#475569"/>
    <SolidColorBrush x:Key="ToastCloseHoverBgBrush" Color="#180f172a"/>
    <SolidColorBrush x:Key="ToastTrackBgBrush" Color="#140f172a"/>
    <SolidColorBrush x:Key="ToastSuccessBgBrush" Color="#f5ecfdf5"/>
    <SolidColorBrush x:Key="ToastSuccessBorderBrush" Color="#8810b981"/>
    <SolidColorBrush x:Key="ToastErrorBgBrush" Color="#f5fff1f2"/>
    <SolidColorBrush x:Key="ToastErrorBorderBrush" Color="#88f43f5e"/>
    <SolidColorBrush x:Key="ToastWarningBgBrush" Color="#f5fffbeb"/>
    <SolidColorBrush x:Key="ToastWarningBorderBrush" Color="#88f59e0b"/>
    <SolidColorBrush x:Key="ToastInfoBgBrush" Color="#f5f0f9ff"/>
    <SolidColorBrush x:Key="ToastInfoBorderBrush" Color="#880284c7"/>
</ResourceDictionary>
