<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core Surfaces (Fluent 2 Dark Palette) -->
    <SolidColorBrush x:Key="BgBrush" Color="#0b101b"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#090e18"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#1c2233"/>
    <SolidColorBrush x:Key="CardBrush" Color="#141b2b"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#181e30"/>
    <SolidColorBrush x:Key="CardActiveBrush" Color="#1f273d"/>
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#0e1420"/>
    <SolidColorBrush x:Key="CardSurfaceSubtleBrush" Color="#090c13"/>
    <SolidColorBrush x:Key="CardSurfaceElevatedBrush" Color="#131b2e"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="#263248"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#334155"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#6366f1"/>

    <!-- Inputs, Popups & Badges -->
    <SolidColorBrush x:Key="InputBgBrush" Color="#0c1018"/>
    <SolidColorBrush x:Key="InputFocusBgBrush" Color="#0f1420"/>
    <SolidColorBrush x:Key="PopupBgBrush" Color="#131a29"/>
    <SolidColorBrush x:Key="PopupHoverBrush" Color="#1f2438"/>
    <SolidColorBrush x:Key="PopupSelectedBrush" Color="#141829"/>
    <SolidColorBrush x:Key="ChipBgBrush" Color="#20283d"/>
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#303c54"/>
    <SolidColorBrush x:Key="SectionBadgeBgBrush" Color="#242840"/>
    <SolidColorBrush x:Key="SectionBadgeBorderBrush" Color="#343955"/>
    <SolidColorBrush x:Key="BadgePillBgBrush" Color="#1b2140"/>
    <SolidColorBrush x:Key="BadgePillBorderBrush" Color="#3b3f6d"/>
    <SolidColorBrush x:Key="IndigoCardBgBrush" Color="#1e1b4b"/>
    <SolidColorBrush x:Key="IndigoCardBorderBrush" Color="#312e81"/>

    <!-- Controls & Navigation -->
    <SolidColorBrush x:Key="ToggleTrackOffBgBrush" Color="#181d2e"/>
    <SolidColorBrush x:Key="ToggleTrackOffBorderBrush" Color="#2b344e"/>
    <SolidColorBrush x:Key="ToggleThumbOffBrush" Color="#64748b"/>
    <SolidColorBrush x:Key="CheckBoxBgBrush" Color="#121626"/>
    <SolidColorBrush x:Key="NavTabHoverBgBrush" Color="#141926"/>
    <SolidColorBrush x:Key="NavTabSelectedTextBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="GhostHoverBgBrush" Color="#171d2b"/>
    <SolidColorBrush x:Key="GhostPressedBgBrush" Color="#20273a"/>
    <SolidColorBrush x:Key="ListItemHoverBgBrush" Color="#0e1320"/>
    <SolidColorBrush x:Key="ListItemSelectedBgBrush" Color="#151b2b"/>
    <SolidColorBrush x:Key="ScrollThumbBgBrush" Color="#262f47"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4f46e5"/>
    <SolidColorBrush x:Key="MeterTrackBgBrush" Color="#202b40"/>

    <!-- Accents & Gradients -->
    <SolidColorBrush x:Key="AccentBrush" Color="#818cf8"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#4f46e5"/>
    <SolidColorBrush x:Key="AccentNeonBrush" Color="#6366f1"/>
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#06b6d4"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#c7d2fe"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366f1" Offset="0.0"/>
        <GradientStop Color="#8b5cf6" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShieldActiveGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10b981" Offset="0.0"/>
        <GradientStop Color="#059669" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#f43f5e" Offset="0.0"/>
        <GradientStop Color="#e11d48" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Status Indicators -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10b981"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#34d399"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#052e23"/>
    <SolidColorBrush x:Key="SuccessBgSubtleBrush" Color="#0a231b"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#065f46"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#f43f5e"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#fda4af"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#341018"/>
    <SolidColorBrush x:Key="DangerBgSubtleBrush" Color="#291219"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#881337"/>
    <SolidColorBrush x:Key="DangerHoverBgBrush" Color="#4a1520"/>

    <SolidColorBrush x:Key="WarningBrush" Color="#f59e0b"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#fcd089"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#2e1d08"/>
    <SolidColorBrush x:Key="WarningBgSubtleBrush" Color="#261b0c"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#78350f"/>

    <SolidColorBrush x:Key="InfoBrush" Color="#38bdf8"/>
    <SolidColorBrush x:Key="InfoTextBrush" Color="#7dd3fc"/>
    <SolidColorBrush x:Key="BlueBgSubtleBrush" Color="#0d2133"/>
    <SolidColorBrush x:Key="BlueBorderBrush" Color="#075985"/>

    <SolidColorBrush x:Key="CyanBgSubtleBrush" Color="#0a222e"/>
    <SolidColorBrush x:Key="CyanBorderBrush" Color="#164e63"/>

    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#a855f7"/>
    <SolidColorBrush x:Key="PurpleBgSubtleBrush" Color="#221530"/>
    <SolidColorBrush x:Key="PurpleBorderBrush" Color="#581c87"/>

    <SolidColorBrush x:Key="AccentTealBrush" Color="#14b8a6"/>
    <SolidColorBrush x:Key="TealBgSubtleBrush" Color="#0a2321"/>
    <SolidColorBrush x:Key="TealBorderBrush" Color="#134e48"/>

    <SolidColorBrush x:Key="IndigoBgSubtleBrush" Color="#181c38"/>
    <SolidColorBrush x:Key="IndigoBorderBrush" Color="#3730a3"/>

    <!-- Typography & Overlays -->
    <SolidColorBrush x:Key="TextBrush" Color="#f8fafc"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#a4b3c9"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8190a8"/>
    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#B805070E"/>
    <SolidColorBrush x:Key="ModalSurfaceBrush" Color="#f0101726"/>
    <SolidColorBrush x:Key="EditorCanvasBgBrush" Color="#090e1a"/>

    <!-- Toast Card Tokens -->
    <SolidColorBrush x:Key="ToastTextBrush" Color="#f1f5f9"/>
    <SolidColorBrush x:Key="ToastCloseStrokeBrush" Color="#94a3b8"/>
    <SolidColorBrush x:Key="ToastCloseHoverBgBrush" Color="#22ffffff"/>
    <SolidColorBrush x:Key="ToastTrackBgBrush" Color="#18ffffff"/>
    <SolidColorBrush x:Key="ToastSuccessBgBrush" Color="#f20c1d1b"/>
    <SolidColorBrush x:Key="ToastSuccessBorderBrush" Color="#4410b981"/>
    <SolidColorBrush x:Key="ToastErrorBgBrush" Color="#f2241015"/>
    <SolidColorBrush x:Key="ToastErrorBorderBrush" Color="#55f43f5e"/>
    <SolidColorBrush x:Key="ToastWarningBgBrush" Color="#f2241b0b"/>
    <SolidColorBrush x:Key="ToastWarningBorderBrush" Color="#55f59e0b"/>
    <SolidColorBrush x:Key="ToastInfoBgBrush" Color="#f20c1929"/>
    <SolidColorBrush x:Key="ToastInfoBorderBrush" Color="#4438bdf8"/>
</ResourceDictionary>
