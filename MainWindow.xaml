                                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:RecoveryState.Recovered}">
                                                                        <Setter Property="Background" Value="#102d28"/><Setter Property="BorderBrush" Value="#205246"/><Setter Property="TextElement.Foreground" Value="#6ee7b7"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:RecoveryState.Failed}">
