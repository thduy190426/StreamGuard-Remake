<Window x:Class="StreamGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:StreamGuard.Localization"
        xmlns:ui="clr-namespace:StreamGuard.Controls"
        xmlns:models="clr-namespace:StreamGuard.Models"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Driver Booster"
        Icon="Assets/AppIcon.ico"
        Width="860" Height="600"
        MinWidth="640" MinHeight="460"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="SidebarResizeHandle" TargetType="Thumb">
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="ResizeLine" Width="2" Height="32" CornerRadius="1"
                                    Background="{StaticResource BorderHoverBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResizeLine" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ResizeLine" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="ResizeLine" Property="Height" Value="48"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ResizeLine" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Shared vector icons: decorative paths keep localized labels as the control content. -->
        <Geometry x:Key="SectionIconCapture">M3,4 H21 V16 H3 Z M8,20 H16 M12,16 V20</Geometry>
        <Geometry x:Key="SectionIconNetwork">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M2,12 H22 M12,2 C6,7 6,17 12,22 M12,2 C18,7 18,17 12,22</Geometry>
        <Geometry x:Key="SectionIconCamera">M3,7 H7 L9,4 H15 L17,7 H21 V20 H3 Z M16,13 A4,4 0 1 0 8,13 A4,4 0 1 0 16,13</Geometry>
        <Geometry x:Key="SectionIconFocus">M2,9 V3 H8 M16,3 H22 V9 M22,15 V21 H16 M8,21 H2 V15 M16,12 A4,4 0 1 0 8,12 A4,4 0 1 0 16,12</Geometry>
        <Geometry x:Key="SectionIconClipboard">M8,4 H5 V22 H21 V4 H18 M8,2 H18 V7 H8 Z M9,12 H17 M9,17 H17</Geometry>
        <Geometry x:Key="SectionIconBrowser">M2,3 H22 V21 H2 Z M2,8 H22 M6,5.5 H6.1 M9,5.5 H9.1 M9,12 L6,15 L9,18 M15,12 L18,15 L15,18</Geometry>
        <Geometry x:Key="SectionIconKeyboard">M2,5 H22 V19 H2 Z M6,9 H6.1 M10,9 H10.1 M14,9 H14.1 M18,9 H18.1 M6,12 H6.1 M10,12 H10.1 M14,12 H14.1 M18,12 H18.1 M7,16 H17</Geometry>
        <Geometry x:Key="SectionIconShield">M12,2 L3,6 V12 C3,17 7,21 12,23 C17,21 21,17 21,12 V6 Z M8,12 L11,15 L16,9</Geometry>
        <Geometry x:Key="ActionIconScan">M16,10 A6,6 0 1 0 4,10 A6,6 0 1 0 16,10 M14.5,14.5 L21,21</Geometry>
        <Geometry x:Key="ActionIconCurtain">M3,3 H21 V21 H3 Z M7,3 V17 M12,3 V17 M17,3 V17 M3,17 H21</Geometry>
        <Geometry x:Key="ActionIconPlay">M7,3 L21,12 L7,21 Z</Geometry>
        <Geometry x:Key="ActionIconCopy">M8,8 H21 V22 H8 Z M16,8 V2 H2 V16 H8</Geometry>
        <Geometry x:Key="ActionIconBookmark">M5,2 H19 V22 L12,17 L5,22 Z</Geometry>
        <Geometry x:Key="ActionIconReset">M3,10 A9,9 0 1 1 5,18 M3,3 V10 H10</Geometry>
        <Geometry x:Key="SectionIconCrop">M6,2 V18 H22 M2,6 H18 V22</Geometry>
        <Geometry x:Key="ActionIconCrop">M6,2 V18 H22 M2,6 H18 V22</Geometry>
        <Geometry x:Key="ActionIconBrowseFolder">M3,7 H9 L11,9 H21 V19 H3 Z M9,14 H9.1 M12,14 H12.1 M15,14 H15.1</Geometry>
        <Geometry x:Key="ActionIconOpenFolder">M4,4 H11 V6 H4 V18 H16 V11 H18 V18 A2,2 0 0 1 16,20 H4 A2,2 0 0 1 2,18 V6 A2,2 0 0 1 4,4 M13,2 H20 V9 M19,3 L10,12</Geometry>
        <Geometry x:Key="ActionIconDelete">M3,6 H21 M8,6 V4 H16 V6 M19,6 V20 A2,2 0 0 1 17,22 H7 A2,2 0 0 1 5,20 V6 M10,11 V17 M14,11 V17</Geometry>
        <Geometry x:Key="ActionIconChevronUp">M5,15 L12,8 L19,15</Geometry>
        <Geometry x:Key="ActionIconChevronDown">M5,9 L12,16 L19,9</Geometry>
        <Geometry x:Key="ActionIconToTop">M4,4 H20 M12,8 L6,14 M12,8 L18,14 M12,8 V20</Geometry>
        <Geometry x:Key="ActionIconToBottom">M4,20 H20 M12,16 L6,10 M12,16 L18,10 M12,16 V4</Geometry>
        <Geometry x:Key="ActionIconExpand">M15,3 H21 V9 M21,3 L14,10 M9,21 H3 V15 M3,21 L10,14</Geometry>
        <Geometry x:Key="ActionIconCollapse">M21,14 H15 V20 M15,14 L22,7 M3,10 H9 V4 M9,10 L2,17</Geometry>
        <Geometry x:Key="SectionIconCursor">M4,2 L4,20 L8.5,15.5 L12.5,23 L15.5,21.5 L11.5,14 L17,14 Z</Geometry>
        <Style x:Key="SectionIconPath" TargetType="Path">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToggleSwitchWithLabelStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="40" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border x:Name="TrackOff" CornerRadius="11" Background="#181d2e" BorderBrush="#2b344e" BorderThickness="1"/>
                                <Border x:Name="TrackOn" CornerRadius="11" Background="{StaticResource ShieldActiveGradient}" BorderBrush="#10b981" BorderThickness="1" Opacity="0"/>
                                <Ellipse x:Name="Thumb" Width="14" Height="14"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="#64748b" Margin="4,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                    <Style TargetType="AccessText"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#64748b" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Thumb" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="18" Y="0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="TrackOn" Property="Opacity" Value="1"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackOff" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="IconActionContent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <ContentPresenter Content="{Binding}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="LanguageSelectorItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="OptionBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Path x:Name="SelectedMark" Grid.Column="1" Data="M 1 5 L 4 8 L 10 1"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#20283c"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#252a49"/>
                                <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguageSelector" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#0c111d"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LanguageSelectorItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="SelectorToggle" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="SelectorBorder" CornerRadius="8"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid Margin="13,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="14"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Ellipse Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.2"/>
                                                    <Ellipse Width="6" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.1"/>
                                                    <Path Data="M 0 7.5 L 15 7.5" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.1"/>
                                                </Grid>
                                                <Path x:Name="SelectorChevron" Grid.Column="2" Data="M 1 2 L 5 6 L 9 2"
                                                      Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SelectorBorder" Property="Background" Value="#151c2d"/>
                                                <Setter TargetName="SelectorBorder" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="SelectorBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="SelectorChevron" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="SelectorChevron" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="39,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,6,0,0" Padding="5" CornerRadius="9"
                                        Background="#131a29" BorderBrush="#303a50" BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SelectorToggle" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TranscriptSelector" TargetType="ComboBox" BasedOn="{StaticResource LanguageSelector}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="SelectorToggle" Focusable="False" ClickMode="Press"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="SelectorBorder" Background="#0c111d" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectorBorder" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectorBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,5,0,0" Padding="5" CornerRadius="8" Background="#131a29" BorderBrush="#303a50" BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectorToggle" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptureOptionCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CaptureCheckBorder" Grid.Column="0" Width="18" Height="18"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="5"
                                    Background="#121626" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1.5">
                                <Path x:Name="CaptureCheckMark" Data="M 3 8 L 7 12 L 13 4" Stroke="White"
                                      StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CaptureCheckBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CaptureCheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CaptureCheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptureCheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BrowserToolbarToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#181d2e"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#064e3b"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#059669"/>
                                <Setter Property="Foreground" Value="#34d399"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FloatingPillButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                <TranslateTransform x:Name="WindowTranslateTransform" X="0" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <!-- 1. LEFT SIDEBAR NAVIGATION (Responsive) -->
            <ColumnDefinition x:Name="SidebarCol" Width="210"/>
            <!-- 2. MAIN CONTENT AREA -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             COLUMN 0: MODERN LEFT SIDEBAR (RESPONSIVE)
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>   <!-- App Brand -->
                    <RowDefinition Height="Auto"/> <!-- Navigation Menu -->
                    <RowDefinition Height="*"/>    <!-- Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Panic Action -->
                </Grid.RowDefinitions>

                <!-- Brand / Logo Area -->
                <Grid x:Name="SidebarBrandRow" Grid.Row="0" Margin="12,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- App Logo Icon -->
                        <Border x:Name="SidebarLogo" Width="28" Height="28" CornerRadius="7" ClipToBounds="True" Background="Transparent" Margin="0,0,8,0">
                            <Image x:Name="SidebarLogoImage" Source="Assets/AppIcon.ico" Width="28" Height="28"
                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel x:Name="SidebarBrandText" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AppBrandText" Text="Driver Booster" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                <Border Background="#1b1d36" BorderBrush="#3b3f6d" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="VersionText" Text="ProMax" FontSize="8" FontWeight="Bold"
                                               Foreground="#a5b4fc"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SidebarSubtitleText" Text="{loc:Translate Key=UI.002}" FontSize="9"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Navigation Items -->
                <StackPanel Grid.Row="1" Margin="0,6,0,0">
                    <RadioButton x:Name="TabProtected"
                                 Style="{StaticResource NavTabRadio}"
                                 IsChecked="True" Checked="Tab_Checked"
                                 ui:NavTab.AccentBrush="{StaticResource SuccessBrush}"
                                 ui:NavTab.ActiveBackgroundBrush="{StaticResource SuccessBgSubtleBrush}"
                                 ui:NavTab.IconBrush="{StaticResource SuccessBrush}"
                                 ToolTip="{loc:Translate Key=UI.003}" AutomationProperties.Name="{loc:Translate Key=UI.003}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Data="M12 2L4 5V11C4 16.5 7.4 21.6 12 23C16.6 21.6 20 16.5 20 11V5L12 2Z"
                                  Fill="{Binding Path=(ui:NavTab.IconBrush), RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Opacity="0.9"
                                  Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TabProtectedText" Grid.Column="1" Text="{loc:Translate Key=UI.004}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="TabAvailable"
                                 Style="{StaticResource NavTabRadio}"
                                 Checked="Tab_Checked"
                                 ui:NavTab.AccentBrush="{StaticResource AccentCyanBrush}"
                                 ui:NavTab.ActiveBackgroundBrush="{StaticResource CyanBgSubtleBrush}"
                                 ui:NavTab.IconBrush="{StaticResource AccentCyanBrush}"
                                 ToolTip="{loc:Translate Key=UI.005}" AutomationProperties.Name="{loc:Translate Key=UI.005}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Fill="{Binding Path=(ui:NavTab.IconBrush), RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Opacity="0.9"
                                  Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TabAvailableText" Grid.Column="1" Text="{loc:Translate Key=UI.006}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="TabThreats"
                                 Style="{StaticResource NavTabRadio}"
                                 Checked="Tab_Checked"
                                 ui:NavTab.AccentBrush="{StaticResource DangerBrush}"
                                 ui:NavTab.ActiveBackgroundBrush="{StaticResource DangerBgSubtleBrush}"
                                 ui:NavTab.IconBrush="{StaticResource DangerBrush}"
                                 ToolTip="{loc:Translate Key=UI.007}" AutomationProperties.Name="{loc:Translate Key=UI.007}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                                  Fill="{Binding Path=(ui:NavTab.IconBrush), RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Opacity="0.9"
                                  Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TabThreatsText" Grid.Column="1" Text="{loc:Translate Key=UI.008}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="TabRecovery" Style="{StaticResource NavTabRadio}" Checked="Tab_Checked"
                                 ui:NavTab.AccentBrush="{StaticResource WarningBrush}"
                                 ui:NavTab.ActiveBackgroundBrush="{StaticResource WarningBgSubtleBrush}"
                                 ui:NavTab.IconBrush="{StaticResource WarningBrush}"
                                 ToolTip="{loc:Translate Key=Recovery.Title}" AutomationProperties.Name="{loc:Translate Key=Recovery.Title}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Data="M4,9 A8,8 0 1 1 4,17 M4,3 V9 H10 M12,7 V12 L15,14"
                                  Stroke="{Binding Path=(ui:NavTab.IconBrush), RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Opacity="0.9"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TabRecoveryText" Grid.Column="1" Text="{loc:Translate Key=Recovery.Title}"
                                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="TabCaptions" Style="{StaticResource NavTabRadio}" Checked="Tab_Checked"
                                 ui:NavTab.AccentBrush="{StaticResource AccentPurpleBrush}"
                                 ui:NavTab.ActiveBackgroundBrush="{StaticResource PurpleBgSubtleBrush}"
                                 ui:NavTab.IconBrush="{StaticResource AccentPurpleBrush}"
                                 ToolTip="{loc:Translate Key=Captions.Title}" AutomationProperties.Name="{loc:Translate Key=Captions.Title}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Data="M3,4 H21 V18 H15 L11,22 V18 H3 Z M6,8 H11 M6,12 H10 M14,8 H18 M14,12 H18"
                                  Stroke="{Binding Path=(ui:NavTab.IconBrush), RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8"
                                  Opacity="0.9"
                                  StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TabCaptionsText" Grid.Column="1" Text="{loc:Translate Key=Captions.Title}"
                                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="TabBrowser" Style="{StaticResource NavTabRadio}" Checked="Tab_Checked"
                                 ui:NavTab.AccentBrush="{StaticResource AccentTealBrush}"
                                 ui:NavTab.ActiveBackgroundBrush="{StaticResource TealBgSubtleBrush}"
                                 ui:NavTab.IconBrush="{StaticResource AccentTealBrush}"
                                 ToolTip="{loc:Translate Key=Sidebar.Browser}" AutomationProperties.Name="{loc:Translate Key=Sidebar.Browser}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                                  Fill="{Binding Path=(ui:NavTab.IconBrush), RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Opacity="0.9"
                                  Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TabBrowserText" Grid.Column="1" Text="{loc:Translate Key=Sidebar.Browser}"
                                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="TabDiagnostics" Style="{StaticResource NavTabRadio}" Checked="Tab_Checked"
                                 ui:NavTab.AccentBrush="{StaticResource AccentBrush}"
                                 ui:NavTab.ActiveBackgroundBrush="{StaticResource IndigoBgSubtleBrush}"
                                 ui:NavTab.IconBrush="{StaticResource AccentBrush}"
                                 ToolTip="{loc:Translate Key=Sidebar.Diagnostics}" AutomationProperties.Name="{loc:Translate Key=Sidebar.Diagnostics}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource UiIconCpu}"
                                  Stroke="{Binding Path=(ui:NavTab.IconBrush), RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Opacity="0.9"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TabDiagnosticsText" Grid.Column="1" Text="{loc:Translate Key=Sidebar.Diagnostics}"
                                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="TabSettings"
                                 Style="{StaticResource NavTabRadio}"
                                 Checked="Tab_Checked"
                                 ui:NavTab.AccentBrush="{StaticResource InfoBrush}"
                                 ui:NavTab.ActiveBackgroundBrush="{StaticResource BlueBgSubtleBrush}"
                                 ui:NavTab.IconBrush="{StaticResource InfoBrush}"
                                 ToolTip="{loc:Translate Key=UI.009}" AutomationProperties.Name="{loc:Translate Key=UI.009}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Data="M20 5H4c-1.1 0-1.99.9-1.99 2L2 17c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-9 3h2v2h-2V8zm0 3h2v2h-2v-2zM8 8h2v2H8V8zm0 3h2v2H8v-2zm-1 2H5v-2h2v2zm0-3H5V8h2v2zm9 7H8v-2h8v2zm0-4h-2v-2h2v2zm0-3h-2V8h2v2zm3 3h-2v-2h2v2zm0-3h-2V8h2v2z"
                                  Fill="{Binding Path=(ui:NavTab.IconBrush), RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Opacity="0.9"
                                  Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TabSettingsText" Grid.Column="1" Text="{loc:Translate Key=UI.010}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom Panic Area -->
                <Border Grid.Row="3" Margin="8,0,8,12" Padding="0,10,0,0"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Button x:Name="BtnPanic"
                                Style="{StaticResource DangerButton}"
                                Height="34" Padding="6,0"
                                HorizontalAlignment="Stretch"
                                Click="BtnPanic_Click"
                                ToolTip="{loc:Translate Key=UI.011}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path x:Name="PanicIcon" Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
                                      Fill="{StaticResource DangerBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0"/>
                                <TextBlock x:Name="PanicText" Text="{loc:Translate Key=UI.012}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="PanicHintText" Text="Ctrl+Shift+Alt+H" FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock x:Name="AppVersionFooterText" Text="v1.9.4" FontSize="9"
                                   FontFamily="Consolas, Segoe UI"
                                   Foreground="{StaticResource TextMutedBrush}" Opacity="0.8"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Thumb x:Name="SidebarResizeThumb" Grid.Column="0" Width="8" HorizontalAlignment="Right"
               Panel.ZIndex="10" Style="{StaticResource SidebarResizeHandle}"
               ToolTip="{loc:Translate Key=Sidebar.ResizeHint}"
               AutomationProperties.Name="{loc:Translate Key=Sidebar.ResizeHint}"
               WindowChrome.IsHitTestVisibleInChrome="True"
               DragStarted="SidebarResize_DragStarted" DragDelta="SidebarResize_DragDelta"
               DragCompleted="SidebarResize_DragCompleted" KeyDown="SidebarResize_KeyDown"/>

        <!-- ══════════════════════════════════════════════════════════════
             COLUMN 1: MAIN CONTENT AREA
             ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>   <!-- TitleBar / Controls -->
                <RowDefinition Height="Auto"/> <!-- Live Status & Control Banner -->
                <RowDefinition Height="*"/>    <!-- Active View Area -->
            </Grid.RowDefinitions>

            <!-- 1. TITLEBAR & WINDOW CONTROLS -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown"
                    MouseMove="TitleBar_MouseMove" MouseLeftButtonUp="TitleBar_MouseUp" LostMouseCapture="TitleBar_LostMouseCapture">
                <Grid>
                    <!-- Left: Sidebar Toggle + Stealth Protection Pill -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Sidebar Toggle Button -->
                        <Button x:Name="BtnToggleSidebar"
                                Style="{StaticResource GhostButton}" Width="32" Height="30" Padding="0"
                                Click="BtnToggleSidebar_Click" ToolTip="{loc:Translate Key=UI.014}">
                            <Path Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"
                                  Fill="{StaticResource TextDimBrush}" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>

                        <!-- Quick Snip Button -->
                        <Button x:Name="BtnQuickSnip"
                                Style="{StaticResource GhostButton}" Width="32" Height="30" Padding="0" Margin="4,0,0,0"
                                Click="BtnStartSnipping_Click" ToolTip="{loc:Translate Key=Snipping.QuickSnipTooltip}">
                            <Path Data="{StaticResource SectionIconCrop}"
                                  Style="{StaticResource SectionIconPath}" Width="12" Height="12"/>
                        </Button>

                        <!-- Quick Chrome Focus Lock Button -->
                        <Button x:Name="BtnQuickChromeFocusLock"
                                Style="{StaticResource BaseButton}" Height="30" Padding="8,0" Margin="4,0,0,0"
                                Click="BtnQuickChromeFocusLock_Click"
                                ToolTip="{loc:Translate Key=Browser.QuickFocusLockTooltip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource UiIconShield}"
                                      Fill="#10b981" Stretch="Uniform" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Translate Key=Browser.QuickFocusLock}" FontSize="11" FontWeight="SemiBold" Foreground="#34d399" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border x:Name="CaptureStatusBadge"
                                Background="#131929" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                MinWidth="166" Height="30" VerticalAlignment="Center"
                                CornerRadius="15" Padding="12,0" Margin="8,0,0,0"
                                UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="CaptureStatusDot" Grid.Column="0" Width="6" Height="6" Fill="{StaticResource TextDimBrush}"
                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CaptureBadgeText" Grid.Column="1" Text="{loc:Translate Key=Capture.BadgeUnverified}"
                                           FontSize="10" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextAlignment="Center"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Right: Window Caption Buttons (Windows 11 Style) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnMinimize" Style="{StaticResource GhostButton}" Width="44" Height="42" Padding="0"
                                Click="BtnMinimize_Click" ToolTip="{loc:Translate Key=UI.016}">
                            <Path Data="M19 13H5v-2h14v2z" Fill="{StaticResource TextDimBrush}" Stretch="Uniform" Width="10" Height="10"/>
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource GhostButton}" Width="44" Height="42" Padding="0"
                                Click="BtnMaximize_Click" ToolTip="{loc:Translate Key=UI.017}">
                            <Path x:Name="IconMaximizePath" Data="M4 4h16v16H4V4zm2 2v12h12V6H6z" Fill="{StaticResource TextDimBrush}" Stretch="Uniform" Width="10" Height="10"/>
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButton}" Width="44" Height="42"
                                Click="BtnClose_Click" ToolTip="{loc:Translate Key=UI.018}">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="10" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. LIVE STATUS & CONTROL BANNER + 3. ACTIVE VIEW PANELS (RESPONSIVE SCALING HOST) -->
            <Grid Grid.Row="1" Grid.RowSpan="2" x:Name="MainContentScaleHost">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="MainContentScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                </Grid.LayoutTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

            <Border Grid.Row="0" x:Name="StatusBanner"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1"
                    CornerRadius="8" Margin="12,2,12,8" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Live Pulse Radar -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse x:Name="StatusPulse" Width="20" Height="20" Fill="{StaticResource AccentDimBrush}" Opacity="0.25"/>
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource TextDimBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Status Texts (Auto-trimmed, never collides) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="StatusText"
                                   Text="{loc:Translate Key=UI.019}"
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <WrapPanel Margin="0,2,0,0">
                            <TextBlock Text="{loc:Translate Key=UI.020}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                            <TextBlock x:Name="DesktopAvailText"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10" FontWeight="SemiBold"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Shield Start / Stop Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnProtect"
                                Style="{StaticResource AccentButton}"
                                Height="32" Padding="12,0"
                                Click="BtnProtect_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="BtnProtectIcon" Data="M8 5v14l11-7z" Fill="#ffffff" Stretch="Uniform" Width="9" Height="9" Margin="0,0,6,0"/>
                                <TextBlock x:Name="BtnProtectText" Text="{loc:Translate Key=UI.022}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnStop"
                                Style="{StaticResource BaseButton}"
                                Height="32" Padding="12,0" Margin="6,0,0,0"
                                Click="BtnStop_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="BtnStopIcon" Data="M6 6h12v12H6z" Fill="{StaticResource TextDimBrush}" Stretch="Uniform" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BtnStopText" Text="{loc:Translate Key=UI.023}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. ACTIVE VIEW PANELS -->
            <Grid Grid.Row="1" Margin="12,0,12,12">

                <!-- ══════════════════════════════════════════════
                     VIEW 1: SHIELD DASHBOARD (PROTECTED APPS)
                     ══════════════════════════════════════════════ -->
                <Grid x:Name="ViewProtected" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Sub-Header Toolbar -->
                    <Grid Grid.Row="0" Margin="0,2,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ui:SectionHeader Title="{loc:Translate Key=UI.024}" Subtitle="{loc:Translate Key=UI.025}"
                                          Icon="{StaticResource UiIconShield}"
                                          IconBrush="{StaticResource SuccessBrush}"
                                          BadgeBackground="{StaticResource SuccessBgSubtleBrush}"
                                          BadgeBorder="{StaticResource SuccessBorderBrush}"
                                          Margin="0,0,10,0"/>

                        <!-- Quick Add Action and Auto-Engage Switch -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="AutoStartShieldQuickCheckBox"
                                      Style="{StaticResource ToggleSwitchWithLabelStyle}"
                                      Content="{loc:Translate Key=Settings.AutoStartShieldQuickLabel}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      Checked="AutoStartShieldCheckBox_Changed"
                                      Unchecked="AutoStartShieldCheckBox_Changed"
                                      ToolTip="{loc:Translate Key=Settings.AutoStartShieldTooltip}"
                                      AutomationProperties.Name="{loc:Translate Key=Settings.AutoStartShieldQuickLabel}"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BaseButton}"
                                    Height="26" Padding="8,0" Click="BtnAddAppFromDashboard_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                          Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0"/>
                                    <TextBlock Text="{loc:Translate Key=UI.026}" FontSize="10" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Protected Apps Container -->
                    <Border Grid.Row="1" CornerRadius="8"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1">
                        <Grid>
                            <!-- Empty State Placeholder -->
                            <StackPanel x:Name="EmptyStateBorder" Visibility="Collapsed"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="16">
                                <Border Width="44" Height="44" CornerRadius="22" Background="#161b2b" Margin="0,0,0,10" HorizontalAlignment="Center">
                                    <Path Data="M12 2L4 5V11C4 16.5 7.4 21.6 12 23C16.6 21.6 20 16.5 20 11V5L12 2Z"
                                          Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{loc:Translate Key=UI.027}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Translate Key=UI.028}"
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,12" MaxWidth="280"/>
                                <Button ui:Icon.Data="{StaticResource UiIconPlus}" Content="{loc:Translate Key=UI.029}" Style="{StaticResource AccentButton}"
                                        Height="30" Padding="12,0" HorizontalAlignment="Center" FontSize="11"
                                        Click="BtnAddAppFromDashboard_Click"/>
                            </StackPanel>

                            <!-- Responsive High-Density Single-Row App List -->
                            <ListBox x:Name="AppListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     AllowDrop="True"
                                     MouseDoubleClick="AppListBox_MouseDoubleClick"
                                     Drop="AppList_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}"
                                                BorderBrush="{StaticResource BorderBrush2}"
                                                BorderThickness="1"
                                                CornerRadius="6" Padding="8,6" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Col 0: App info (Name, Process, Status) -->
                                                    <ColumnDefinition Width="*" MinWidth="130"/>
                                                    <!-- Col 1: Action Controls (Hotkey, Toggle, Buttons) -->
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 0. App Identity & Status (Gracefully trims on narrow widths) -->
                                                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon -->
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                                            Background="#161a28" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Image Source="{Binding Icon}" Width="18" Height="18"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Name + Badges -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Name}"/>
                                                        <WrapPanel Margin="0,3,0,0">
                                                            <Border Background="#20283d" CornerRadius="4" Padding="5,2" Margin="0,0,6,2" VerticalAlignment="Center" MaxWidth="160">
                                                                <TextBlock Text="{Binding ProcessName}"
                                                                           FontSize="9"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessName}"/>
                                                            </Border>
                                                            <Border Background="#111624" BorderBrush="{StaticResource BorderBrush2}"
                                                                    BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,0,2" MaxWidth="340">
                                                                <TextBlock Text="{loc:Translate Path=Status}" FontSize="9" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" ToolTip="{loc:Translate Path=Status}"/>
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 1. Controls & Quick Actions (Never overlaps) -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Hotkey Keyboard Badge (Smart Interactive Recorder) -->
                                                    <Border Background="#13192b" BorderBrush="#312e81"
                                                            BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,6,0" VerticalAlignment="Center"
                                                            ToolTip="{loc:Translate Key=UI.030}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Keyboard Icon with Indigo tint -->
                                                            <Path Data="M20 5H4c-1.1 0-1.99.9-1.99 2L2 17c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-9 3h2v2h-2V8zm0 3h2v2h-2v-2zM8 8h2v2H8V8zm0 3h2v2H8v-2zm-1 2H5v-2h2v2zm0-3H5V8h2v2zm9 7H8v-2h8v2zm0-4h-2v-2h2v2zm0-3h-2V8h2v2zm3 3h-2v-2h2v2zm0-3h-2V8h2v2z"
                                                                  Fill="#818cf8" Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBox Text="{Binding SecureHotkey, Mode=OneWay}"
                                                                     Width="88" Height="18"
                                                                     Padding="0" FontSize="11" FontWeight="SemiBold"
                                                                     Foreground="#c7d2fe"
                                                                     Background="Transparent"
                                                                     BorderThickness="0"
                                                                     VerticalContentAlignment="Center"
                                                                     HorizontalContentAlignment="Center"
                                                                     IsReadOnly="True"
                                                                     Cursor="Arrow"
                                                                     Focusable="True"
                                                                     Tag="{Binding}"
                                                                     GotFocus="SecureHotkey_GotFocus"
                                                                     LostFocus="SecureHotkey_LostFocus"
                                                                     PreviewKeyDown="SecureHotkey_PreviewKeyDown"
                                                                     PreviewMouseDown="SecureHotkey_PreviewMouseDown"
                                                                     ToolTip="{loc:Translate Key=UI.031}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Enable Switch -->
                                                    <CheckBox IsChecked="{Binding IsEnabled}"
                                                              Style="{StaticResource ToggleStyle}"
                                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                                              Tag="{Binding}"
                                                              Click="AppEnabledCheckBox_Click"
                                                              ToolTip="{loc:Translate Key=UI.032}"/>

                                                    <!-- Secure Button -->
                                                    <Button ui:Icon.Data="{StaticResource UiIconLock}" Content="{loc:Translate Key=UI.033}" Style="{StaticResource BaseButton}"
                                                            Height="24" Padding="6,0" FontSize="10"
                                                            Margin="0,0,3,0" Tag="{Binding}"
                                                            Click="SecureApp_Click"
                                                            ToolTip="{loc:Translate Key=UI.034}"/>

                                                    <!-- Control Button -->
                                                    <Button ui:Icon.Data="{StaticResource UiIconEye}" Content="{loc:Translate Key=UI.035}" Style="{StaticResource BaseButton}"
                                                            Height="24" Padding="6,0" FontSize="10"
                                                            Margin="0,0,3,0" Tag="{Binding}"
                                                            Click="FocusApp_Click"
                                                            ToolTip="{loc:Translate Key=UI.036}"/>

                                                    <!-- Remove Button -->
                                                    <Button Style="{StaticResource CaptionCloseButton}"
                                                            Width="20" Height="20" Tag="{Binding}"
                                                            Click="RemoveApp_Click"
                                                            ToolTip="{loc:Translate Key=UI.037}">
                                                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                              Fill="{StaticResource TextMutedBrush}" Stretch="Uniform" Width="8" Height="8"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════
                     VIEW 2: RUNNING EXPLORER (AVAILABLE APPS)
                     ══════════════════════════════════════════════ -->
                <Grid x:Name="ViewAvailable" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search & Action Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <Border Grid.Column="0" Background="#0c0f18" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="6" Padding="8,0" Height="30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Fill="{StaticResource TextMutedBrush}" Stretch="Uniform" Width="11" Height="11"
                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="SearchPlaceholderText" Grid.Column="1"
                                           Text="{loc:Translate Key=UI.038}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Visible"/>
                                <TextBox Grid.Column="1" x:Name="SearchBox"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextBrush}"
                                         FontSize="11" VerticalAlignment="Center"
                                         CaretBrush="{StaticResource AccentBrush}"
                                         TextChanged="SearchBox_TextChanged"/>
                                <Button Grid.Column="2" x:Name="BtnClearSearch"
                                        Style="{StaticResource GhostButton}" Width="18" Height="18" Padding="0"
                                        Visibility="Collapsed" Click="BtnClearSearch_Click">
                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                          Fill="{StaticResource TextMutedBrush}" Stretch="Uniform" Width="7" Height="7"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Refresh Button -->
                        <Button Grid.Column="1" x:Name="BtnRefreshApps"
                                ui:Icon.Data="{StaticResource UiIconRefresh}"
                                Content="{loc:Translate Key=UI.039}"
                                Style="{StaticResource BaseButton}"
                                Height="30" Padding="10,0" Margin="6,0,0,0" FontSize="11"
                                Click="RefreshApps_Click"/>

                        <!-- Add Selected Button -->
                        <Button Grid.Column="2" x:Name="BtnAddApp"
                                ui:Icon.Data="{StaticResource UiIconPlus}"
                                Content="{loc:Translate Key=UI.040}"
                                Style="{StaticResource AccentButton}"
                                Height="30" Padding="10,0" Margin="6,0,0,0" FontSize="11"
                                Click="AddApp_Click"/>
                    </Grid>

                    <ui:SectionHeader Grid.Row="1" Title="{loc:Translate Key=UI.006}" Subtitle="{loc:Translate Key=UI.041}"
                                      Icon="{StaticResource UiIconWindows}"
                                      IconBrush="{StaticResource AccentCyanBrush}"
                                      BadgeBackground="{StaticResource CyanBgSubtleBrush}"
                                      BadgeBorder="{StaticResource CyanBorderBrush}"
                                      Margin="0,2,0,12"/>

                    <Border Grid.Row="2" CornerRadius="8"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1">
                        <Grid>
                            <!-- Empty State Placeholder for Available Windows -->
                            <StackPanel x:Name="AvailableEmptyState" Visibility="Collapsed"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="16">
                                <Border Width="40" Height="40" CornerRadius="20" Background="#161b2b" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                          Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="AvailableEmptyStateTitle" Text="{loc:Translate Key=UI.042}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="AvailableEmptyStateSubtitle" Text="{loc:Translate Key=UI.043}"
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,10" MaxWidth="260"/>
                                <Button ui:Icon.Data="{StaticResource UiIconRefresh}" Content="{loc:Translate Key=UI.044}" Style="{StaticResource BaseButton}"
                                        Height="26" Padding="12,0" HorizontalAlignment="Center" FontSize="10"
                                        Click="BtnClearSearch_Click"/>
                            </StackPanel>

                            <ListBox x:Name="AvailableWindowsListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     MouseDoubleClick="AvailableWindowsListBox_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}"
                                                BorderBrush="{StaticResource BorderBrush2}"
                                                BorderThickness="1"
                                                CornerRadius="6" Padding="8,5" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Col 0: Icon -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Col 1: Title + Path -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Col 2: Process Badge -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Col 3: Add Button -->
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- App Icon -->
                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="5"
                                                        Background="#151928" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Width="18" Height="18"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Window Title & Path -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Title}"/>
                                                    <TextBlock Text="{Binding ExecutablePath}"
                                                               FontSize="9"
                                                               Foreground="{StaticResource TextDimBrush}"
                                                               FontFamily="Consolas"
                                                               Margin="0,1,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ExecutablePath}"/>
                                                </StackPanel>

                                                <!-- Process Name Badge -->
                                                <Border Grid.Column="2" Background="#1c2238" CornerRadius="4" Padding="5,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProcessName}"
                                                               FontSize="9"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontFamily="Consolas"/>
                                                </Border>

                                                <!-- Direct 1-Click Add Button -->
                                                <Button Grid.Column="3"
                                                        Height="24" Padding="7,0" FontSize="10"
                                                        Tag="{Binding}" Click="BtnAddSingleWindow_Click"
                                                        ToolTip="{loc:Translate Key=UI.045}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInShieldList}" Value="True">
                                                                    <Setter Property="Background" Value="#0b2922"/>
                                                                    <Setter Property="BorderBrush" Value="#10b981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                                              Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="8" Height="8" Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInShieldList}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                                              Fill="#34d399" Stretch="Uniform" Width="8" Height="8" Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInShieldList}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <TextBlock Text="{loc:Translate Key=UI.046}" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInShieldList}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{loc:Translate Key=UI.046B}" Foreground="#34d399" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInShieldList}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════
                     VIEW 3: PRIVACY & CONTAINMENT
                     ══════════════════════════════════════════════ -->
                <Grid x:Name="ViewThreats" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <ui:SectionHeader Title="{loc:Translate Key=UI.008}" Subtitle="{loc:Translate Key=UiRefresh.PrivacyHint}"
                                              Icon="{StaticResource UiIconShield}"
                                              IconBrush="{StaticResource DangerBrush}"
                                              BadgeBackground="{StaticResource DangerBgSubtleBrush}"
                                              BadgeBorder="{StaticResource DangerBorderBrush}"
                                              Margin="0,2,0,14"/>
                            <!-- Capture protection and optional desktop curtain -->
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="7" Background="#1b2140" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource SectionIconCapture}" Style="{StaticResource SectionIconPath}"/>
                                        </Border>
                                        <TextBlock Text="{loc:Translate Key=Capture.Title}" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <TextBlock x:Name="CaptureAffinityText" Text="{loc:Translate Key=Capture.AffinityUnverified}"
                                               FontSize="10.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="CaptureToolsText" Text="{loc:Translate Key=Capture.NotScanned}"
                                               FontSize="10" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Visibility="Collapsed"/>
                                    <CheckBox x:Name="CaptureGuardCheckBox" Style="{StaticResource ToggleSwitchWithLabelStyle}" Margin="0,0,0,8"
                                              Checked="CaptureGuardPreference_Changed" Unchecked="CaptureGuardPreference_Changed"
                                              ToolTip="{loc:Translate Key=Capture.Limits}">
                                        <TextBlock Text="{loc:Translate Key=Capture.EnableGuard}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="CaptureMultiPurposeCheckBox" Style="{StaticResource ToggleSwitchWithLabelStyle}" Margin="0,0,0,8"
                                              Checked="CaptureGuardPreference_Changed" Unchecked="CaptureGuardPreference_Changed"
                                              ToolTip="{loc:Translate Key=Capture.DetectionScope}">
                                        <TextBlock Text="{loc:Translate Key=Capture.IncludeMultiPurpose}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBlock x:Name="CaptureGuardStateText" Text="{loc:Translate Key=Capture.GuardOff}"
                                               FontSize="10" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Separator Background="{StaticResource BorderBrush2}" Margin="0,2,0,8"/>
                                    <CheckBox x:Name="InAppCursorCloakCheckBox" Style="{StaticResource ToggleSwitchWithLabelStyle}" Margin="0,0,0,8"
                                              Checked="CursorCloakPreference_Changed" Unchecked="CursorCloakPreference_Changed"
                                              ToolTip="{loc:Translate Key=Capture.InAppCursorCloakTip}">
                                        <TextBlock Text="{loc:Translate Key=Capture.InAppCursorCloak}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="GlobalCursorCloakCheckBox" Style="{StaticResource ToggleSwitchWithLabelStyle}" Margin="0,0,0,8"
                                              Checked="CursorCloakPreference_Changed" Unchecked="CursorCloakPreference_Changed"
                                              ToolTip="{loc:Translate Key=Capture.GlobalCursorCloakTip}">
                                        <TextBlock Text="{loc:Translate Key=Capture.GlobalCursorCloak}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBlock x:Name="GlobalCursorCloakStateText" Text="{loc:Translate Key=Capture.GlobalCursorCloakOff}"
                                               FontSize="10" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <WrapPanel Margin="0,0,0,2">
                                        <Button x:Name="BtnScanCaptureTools" Tag="{StaticResource ActionIconScan}" ContentTemplate="{StaticResource IconActionContent}" Content="{loc:Translate Key=Capture.ScanButton}"
                                                Style="{StaticResource BaseButton}" Height="30" FontSize="10" Margin="0,0,6,6"
                                                Click="BtnScanCaptureTools_Click"/>
                                        <Button x:Name="BtnManualCaptureCurtain" Tag="{StaticResource ActionIconCurtain}" ContentTemplate="{StaticResource IconActionContent}" Content="{loc:Translate Key=Capture.ManualCurtain}" Style="{StaticResource BaseButton}"
                                                Height="30" FontSize="10" Margin="0,0,6,6" Click="BtnCaptureCurtain_Click"/>
                                        <Button x:Name="BtnResumeCaptureGuard" Tag="{StaticResource ActionIconPlay}" ContentTemplate="{StaticResource IconActionContent}" Content="{loc:Translate Key=Capture.ResumeButton}"
                                                Style="{StaticResource BaseButton}" Height="30" FontSize="10" Margin="0,0,0,6"
                                                Click="BtnResumeCaptureGuard_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Threat Banner Card -->
                            <Border x:Name="ThreatBanner"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush2}"
                                    BorderThickness="1"
                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ThreatStatusText"
                                                   Text="{loc:Translate Key=UI.047}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="12"
                                                   FontWeight="Bold"/>
                                        <TextBlock x:Name="ThreatDetailText"
                                                   Text="{loc:Translate Key=UI.048}"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   FontSize="10"
                                                   Margin="0,2,8,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" x:Name="BtnBlockRaia"
                                            Content="{loc:Translate Key=UI.049}"
                                            Style="{StaticResource DangerButton}"
                                            Height="30" Padding="12,0" FontSize="11"
