                                                <TextBox Grid.Column="1" x:Name="TranscriptSearchBox"
                                                         Background="Transparent" BorderThickness="0"
                                                         Foreground="{StaticResource TextBrush}"
                                                         FontSize="11" VerticalAlignment="Center"
                                                         CaretBrush="{StaticResource AccentBrush}"
