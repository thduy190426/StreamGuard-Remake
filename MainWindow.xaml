                                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:RecoveryState.Unverified}"><Setter Property="Data" Value="{StaticResource UiIconAlert}"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style></Path.Style>
                                                            </Path>
                                                            <TextBlock x:Name="RecoveryStateLabel" Text="{loc:Translate Path=StatusText}" FontSize="10"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{loc:Translate Path=MethodText}" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,3,8,4"/>
                                                    <TextBlock Text="{loc:Translate Path=SessionText}" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,4"/>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding ExecutablePath}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}"/>
                                                <TextBlock Text="{loc:Translate Path=Detail}" FontSize="10" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
