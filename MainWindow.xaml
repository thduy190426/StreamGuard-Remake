                                                         KeyDown="TranscriptSearchBox_KeyDown"
                                                         AutomationProperties.Name="{loc:Translate Key=Transcripts.SearchPlaceholder}"/>
                                                <Button Grid.Column="2" x:Name="BtnTranscriptClearSearch"
                                                        Style="{StaticResource GhostButton}" Width="18" Height="18" Padding="0"
                                                        Visibility="Collapsed" Click="BtnTranscriptClearSearch_Click"
                                                        ToolTip="{loc:Translate Key=Transcripts.ClearSearchTooltip}">
                                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                          Fill="{StaticResource TextMutedBrush}" Stretch="Uniform" Width="7" Height="7"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="TranscriptSearchCount" Grid.Column="1"
                                                   Text="" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                        <Button Grid.Column="2" x:Name="BtnTranscriptFindPrev"
                                                ui:Icon.Data="{StaticResource ActionIconChevronUp}"
                                                Content="{loc:Translate Key=Transcripts.FindPrev}"
                                                Click="BtnTranscriptFindPrev_Click" Style="{StaticResource BaseButton}"
                                                FontSize="11" Padding="7,4" Height="28" Margin="0,0,4,0"
                                                ToolTip="{loc:Translate Key=Transcripts.FindPrevTooltip}"
                                                AutomationProperties.Name="{loc:Translate Key=Transcripts.FindPrevTooltip}"/>
                                        <Button Grid.Column="3" x:Name="BtnTranscriptFindNext"
                                                ui:Icon.Data="{StaticResource ActionIconChevronDown}"
                                                Content="{loc:Translate Key=Transcripts.FindNext}"
                                                Click="BtnTranscriptFindNext_Click" Style="{StaticResource BaseButton}"
                                                FontSize="11" Padding="7,4" Height="28"
                                                ToolTip="{loc:Translate Key=Transcripts.FindNextTooltip}"
                                                AutomationProperties.Name="{loc:Translate Key=Transcripts.FindNextTooltip}"/>
                                    </Grid>
                                    <Grid>
                                        <TextBox x:Name="CaptionTranscriptText" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                 Height="240" Padding="10" Background="#0c111d" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" FontSize="12" SelectionBrush="{StaticResource AccentBrush}" IsInactiveSelectionHighlightEnabled="True" AutomationProperties.Name="{loc:Translate Key=Transcripts.Title}"
                                                 ContextMenuOpening="CaptionTranscriptText_ContextMenuOpening"
                                                 ScrollViewer.ScrollChanged="CaptionTranscriptText_ScrollChanged">
                                            <TextBox.ContextMenu>
                                                <ContextMenu Background="#121826" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                                    <MenuItem x:Name="MenuTranscriptCopySelected" Header="{loc:Translate Key=Transcripts.CopySelected}" Click="MenuTranscriptCopySelected_Click" Foreground="{StaticResource TextBrush}" InputGestureText="Ctrl+C"/>
                                                    <MenuItem x:Name="MenuTranscriptCopyRecent" Header="{loc:Translate Key=Transcripts.CopyRecent}" Click="MenuTranscriptCopyRecent_Click" Foreground="{StaticResource TextBrush}"/>
                                                    <MenuItem x:Name="MenuTranscriptCopyAll" Header="{loc:Translate Key=Transcripts.CopyAll}" Click="MenuTranscriptCopyAll_Click" Foreground="{StaticResource TextBrush}"/>
                                                    <Separator Background="{StaticResource BorderBrush2}" Margin="2,4"/>
                                                    <MenuItem x:Name="MenuTranscriptSelectAll" Header="{loc:Translate Key=Transcripts.SelectAll}" Click="MenuTranscriptSelectAll_Click" Foreground="{StaticResource TextBrush}" InputGestureText="Ctrl+A"/>
                                                    <MenuItem x:Name="MenuTranscriptScrollBottom" Header="{loc:Translate Key=Transcripts.ScrollBottom}" Click="BtnTranscriptScrollBottom_Click" Foreground="{StaticResource TextBrush}"/>
                                                </ContextMenu>
                                            </TextBox.ContextMenu>
                                        </TextBox>
                                        <Button x:Name="BtnTranscriptScrollLatest"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,0,14"
                                                Click="BtnTranscriptScrollLatest_Click"
                                                Style="{StaticResource FloatingPillButton}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M12,19 L19,12 M12,19 L5,12 M12,19 V5"
                                                      Stroke="#ffffff" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtTranscriptScrollLatest"
                                                           Text="{loc:Translate Key=Transcripts.ScrollToLatest}"
                                                           Foreground="#ffffff" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Path Data="{StaticResource UiIconWindows}" Style="{StaticResource UiStrokeIcon}" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{loc:Translate Key=Captions.Overlay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    </DockPanel>
                                    <CheckBox x:Name="CaptionSingleLineCheckBox" Style="{StaticResource ToggleSwitchWithLabelStyle}" Content="{loc:Translate Key=Captions.SingleLine}" Checked="CaptionOptions_Changed" Unchecked="CaptionOptions_Changed" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="CaptionClickThroughCheckBox" Style="{StaticResource ToggleSwitchWithLabelStyle}" Content="{loc:Translate Key=Captions.ClickThrough}" Checked="CaptionOptions_Changed" Unchecked="CaptionOptions_Changed" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="CaptionCaptureCheckBox" Style="{StaticResource ToggleSwitchWithLabelStyle}" Content="{loc:Translate Key=Captions.Exclude}" Checked="CaptionOptions_Changed" Unchecked="CaptionOptions_Changed" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="CaptionCaptureStatusText" Foreground="{StaticResource TextDimBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Border Background="{StaticResource BorderBrush2}" Height="1" Margin="0,4,0,12"/>
                                    <DockPanel Margin="0,0,0,10">
                                        <Path Data="{StaticResource UiIconLanguage}" Style="{StaticResource UiStrokeIcon}" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{loc:Translate Key=Captions.TranslationSection}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    </DockPanel>
                                    <CheckBox x:Name="CaptionTranslationCheckBox" Style="{StaticResource ToggleSwitchWithLabelStyle}" Content="{loc:Translate Key=Captions.EnableTranslation}" Checked="CaptionOptions_Changed" Unchecked="CaptionOptions_Changed" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="CaptionTranslationModePanel" Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton x:Name="CaptionModeBilingualRadio" Content="{loc:Translate Key=Captions.ModeBilingual}" GroupName="CaptionTransMode" Checked="CaptionOptions_Changed" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,16,0" IsChecked="True"/>
                                        <RadioButton x:Name="CaptionModeVietnameseRadio" Content="{loc:Translate Key=Captions.ModeVietnameseOnly}" GroupName="CaptionTransMode" Checked="CaptionOptions_Changed" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Translate Key=Captions.TranslationHotkeyNotice}" Foreground="{StaticResource TextDimBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Border Background="{StaticResource BorderBrush2}" Height="1" Margin="0,4,0,12"/>
                                    <DockPanel Margin="0,0,0,8">
                                        <Path Data="{StaticResource UiIconKeyboard}" Style="{StaticResource UiStrokeIcon}" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{loc:Translate Key=Captions.VocabularySection}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    </DockPanel>
                                    <TextBlock Text="{loc:Translate Key=Captions.VocabularyHint}" Foreground="{StaticResource TextDimBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CaptionCustomKeywordsTextBox" Padding="8,6" Background="#0c111d" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" FontSize="11" TextWrapping="Wrap" Height="50" AcceptsReturn="False" TextChanged="CaptionCustomKeywordsTextBox_TextChanged"/>
                                        <Button x:Name="BtnCaptionSaveKeywords" Grid.Column="1" ui:Icon.Data="{StaticResource UiIconCheck}" Content="{loc:Translate Key=Captions.SaveVocabulary}" Click="BtnCaptionSaveKeywords_Click" Style="{StaticResource AccentButton}" FontSize="11" Padding="10,6" Margin="8,0,0,0" VerticalAlignment="Stretch"/>
                                        <Button x:Name="BtnCaptionClearKeywords" Grid.Column="2" ui:Icon.Data="{StaticResource ActionIconDelete}" Content="{loc:Translate Key=Captions.ClearVocabulary}" Click="BtnCaptionClearKeywords_Click" Style="{StaticResource BaseButton}" FontSize="11" Padding="10,6" Margin="6,0,0,0" VerticalAlignment="Stretch" ToolTip="{loc:Translate Key=Captions.ClearVocabularyTooltip}" AutomationProperties.Name="{loc:Translate Key=Captions.ClearVocabularyTooltip}"/>
                                    </Grid>
                                    <Button ui:Icon.Data="{StaticResource UiIconRefresh}" Content="{loc:Translate Key=Captions.Reset}" Click="BtnCaptionReset_Click" Style="{StaticResource BaseButton}" FontSize="11" Padding="9,6" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{loc:Translate Key=Captions.Note}" Foreground="{StaticResource TextDimBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ViewBrowser" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Browser Toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Primary Navigation & Address Bar & WDA Badge -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Navigation Buttons -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Button x:Name="BtnBrowserBack" Style="{StaticResource BaseButton}" ToolTip="{loc:Translate Key=Browser.Back}"
                                            AutomationProperties.Name="{loc:Translate Key=Browser.Back}" Width="32" Height="30" Padding="0" Margin="0,0,4,0"
                                            Click="BtnBrowserBack_Click" IsEnabled="False">
                                        <Path Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="12" Height="12"/>
                                    </Button>
                                    <Button x:Name="BtnBrowserForward" Style="{StaticResource BaseButton}" ToolTip="{loc:Translate Key=Browser.Forward}"
                                            AutomationProperties.Name="{loc:Translate Key=Browser.Forward}" Width="32" Height="30" Padding="0" Margin="0,0,4,0"
                                            Click="BtnBrowserForward_Click" IsEnabled="False">
                                        <Path Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="12" Height="12"/>
                                    </Button>
                                    <Button x:Name="BtnBrowserReload" Style="{StaticResource BaseButton}" ToolTip="{loc:Translate Key=Browser.Reload}"
                                            AutomationProperties.Name="{loc:Translate Key=Browser.Reload}" Width="32" Height="30" Padding="0" Margin="0,0,4,0"
                                            Click="BtnBrowserReload_Click">
                                        <Path Data="{StaticResource UiIconRefresh}" Style="{StaticResource UiStrokeIcon}" Width="12" Height="12"/>
                                    </Button>
                                    <Button x:Name="BtnBrowserHome" Style="{StaticResource BaseButton}" ToolTip="{loc:Translate Key=Browser.Home}"
                                            AutomationProperties.Name="{loc:Translate Key=Browser.Home}" Width="32" Height="30" Padding="0" Margin="0,0,0,0"
                                            Click="BtnBrowserHome_Click">
                                        <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="12" Height="12"/>
                                    </Button>
                                </StackPanel>

                                <!-- Address Bar -->
                                <Border Grid.Column="1" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center" Height="32" Margin="0,0,8,0" MinWidth="160">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource UiIconLock}" Style="{StaticResource UiStrokeIcon}" Width="11" Height="11" Margin="8,0,4,0" Opacity="0.7"/>
                                        <TextBox x:Name="TxtBrowserUrl" Grid.Column="1" Background="Transparent" Foreground="{StaticResource TextBrush}"
                                                 BorderThickness="0" VerticalAlignment="Center" FontSize="11.5" Margin="4,0,4,0"
                                                 CaretBrush="{StaticResource AccentBrush}" KeyDown="TxtBrowserUrl_KeyDown"
                                                 AutomationProperties.Name="{loc:Translate Key=Browser.AddressPlaceholder}"/>
                                        <Button x:Name="BtnBrowserGo" Grid.Column="2" Style="{StaticResource BaseButton}" Width="26" Height="24" Padding="0" Margin="0,0,4,0"
                                                ToolTip="{loc:Translate Key=Browser.Go}" AutomationProperties.Name="{loc:Translate Key=Browser.Go}" Click="BtnBrowserGo_Click">
                                            <Path Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="10" Height="10"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- WDA Shield Badge -->
                                <Border Grid.Column="2" Background="#064e3b" BorderBrush="#059669" BorderThickness="1" CornerRadius="12" Padding="8,4" VerticalAlignment="Center"
                                        ToolTip="{loc:Translate Key=Browser.WdaBadgeTooltip}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#10b981" Margin="0,0,5,0"/>
                                        <TextBlock Text="{loc:Translate Key=Browser.WdaBadge}" Foreground="#6ee7b7" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 1: Actions Toolbar -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Copy/Paste Unlock Toggle -->
                                <ToggleButton x:Name="ToggleBrowserCopyPaste" Style="{StaticResource BrowserToolbarToggle}" Margin="0,0,6,2"
                                              ToolTip="{loc:Translate Key=Browser.UnlockClipboardTooltip}" AutomationProperties.Name="{loc:Translate Key=Browser.UnlockClipboard}"
                                              Checked="ToggleBrowserCopyPaste_Checked" Unchecked="ToggleBrowserCopyPaste_Unchecked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource UiIconCopy}" Style="{StaticResource UiStrokeIcon}" Width="11" Height="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="{loc:Translate Key=Browser.UnlockClipboard}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>

                                <!-- Anti-Blur Toggle -->
                                <ToggleButton x:Name="ToggleBrowserAntiBlur" Style="{StaticResource BrowserToolbarToggle}" Margin="0,0,6,2"
                                              ToolTip="{loc:Translate Key=Browser.AntiBlurTooltip}" AutomationProperties.Name="{loc:Translate Key=Browser.AntiBlur}"
                                              Checked="ToggleBrowserAntiBlur_Checked" Unchecked="ToggleBrowserAntiBlur_Unchecked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource UiIconEye}" Style="{StaticResource UiStrokeIcon}" Width="11" Height="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="{loc:Translate Key=Browser.AntiBlur}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>

                                <!-- F12 DevTools Button -->
                                <Button x:Name="BtnBrowserDevTools" Style="{StaticResource BaseButton}" Margin="0,0,6,2" Padding="8,4" Height="30"
                                        ToolTip="{loc:Translate Key=Browser.DevToolsTooltip}" AutomationProperties.Name="{loc:Translate Key=Browser.DevTools}" Click="BtnBrowserDevTools_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource UiIconKeyboard}" Style="{StaticResource UiStrokeIcon}" Width="11" Height="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="{loc:Translate Key=Browser.DevTools}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Open in External Chrome Button -->
                                <Button x:Name="BtnOpenInExternalChrome" Style="{StaticResource BaseButton}" Margin="0,0,6,2" Padding="8,4" Height="30"
                                        ToolTip="{loc:Translate Key=Browser.OpenInExternalChromeTooltip}" AutomationProperties.Name="{loc:Translate Key=Browser.OpenInExternalChrome}" Click="BtnOpenInExternalChrome_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                                              Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="{loc:Translate Key=Browser.OpenInExternalChrome}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Antigravity Login Bridge Button -->
                                <Button x:Name="BtnBrowserAntigravityLogin" Style="{StaticResource AccentButton}" Margin="0,0,0,2" Padding="8,4" Height="30"
                                        ToolTip="{loc:Translate Key=Browser.AntigravityLoginTooltip}" AutomationProperties.Name="{loc:Translate Key=Browser.AntigravityLogin}" Click="BtnBrowserAntigravityLogin_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource UiIconShield}" Style="{StaticResource UiStrokeIcon}" Width="11" Height="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="{loc:Translate Key=Browser.AntigravityLogin}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Browser Display / Fallback Area -->
                    <Grid Grid.Row="1">
                        <!-- WebView2 Control -->
                        <wv2:WebView2 x:Name="BrowserControl" Visibility="Visible"/>

                        <!-- Fallback Panel if WebView2 runtime is missing -->
                        <Border x:Name="BrowserFallbackPanel" Visibility="Collapsed" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="10" Padding="32"
                                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#311018" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Path Data="{StaticResource UiIconAlert}" Stroke="{StaticResource DangerBrush}" StrokeThickness="2" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{loc:Translate Key=Browser.RuntimeMissingTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" TextAlignment="Center"/>
                                <TextBlock Text="{loc:Translate Key=Browser.RuntimeMissingDesc}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,20"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="BtnDownloadWebView2" Content="{loc:Translate Key=Browser.DownloadRuntime}" Style="{StaticResource AccentButton}" Padding="14,8" Margin="0,0,10,0" Click="BtnDownloadWebView2_Click"/>
                                    <Button x:Name="BtnOpenFallbackExternal" Content="{loc:Translate Key=Browser.OpenExternal}" Style="{StaticResource BaseButton}" Padding="14,8" Click="BtnOpenFallbackExternal_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Diagnostics View (Hardware & Compatibility Assessment) -->
                <Grid x:Name="ViewDiagnostics" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,16">
                            <!-- Top Header and Action Buttons -->
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SectionHeader Title="{loc:Translate Key=Diagnostics.Title}" Subtitle="{loc:Translate Key=Diagnostics.Subtitle}"
                                                      Icon="{StaticResource UiIconCpu}"
                                                      IconBrush="{StaticResource AccentBrush}"
                                                      BadgeBackground="{StaticResource IndigoBgSubtleBrush}"
                                                      BadgeBorder="{StaticResource IndigoBorderBrush}"
                                                      VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnRefreshDiagnostics" Style="{StaticResource AccentButton}" Padding="12,6" Margin="0,0,8,0"
                                                ToolTip="{loc:Translate Key=Diagnostics.BtnRefreshTooltip}" Click="BtnRefreshDiagnostics_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource UiIconRefresh}" Style="{StaticResource UiStrokeIcon}" Stroke="White" Width="12" Height="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="{loc:Translate Key=Diagnostics.BtnRefresh}" FontWeight="SemiBold" FontSize="11.5"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnCopyDiagnosticsReport" Style="{StaticResource BaseButton}" Padding="12,6"
                                                ToolTip="{loc:Translate Key=Diagnostics.BtnCopyReportTooltip}" Click="BtnCopyDiagnosticsReport_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource UiIconCopy}" Style="{StaticResource UiStrokeIcon}" Stroke="{StaticResource TextDimBrush}" Width="12" Height="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="{loc:Translate Key=Diagnostics.BtnCopyReport}" FontWeight="SemiBold" FontSize="11.5"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Toast Notification on Copy -->
                            <Border x:Name="DiagnosticsToast" Visibility="Collapsed" Background="#052e23" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource UiIconCheck}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtDiagnosticsToast" Text="{loc:Translate Key=Diagnostics.ReportCopiedToast}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="11.5"/>
                                </StackPanel>
                            </Border>

                            <!-- Overall Readiness Banner (Score Card) -->
                            <Border Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Score Circle / Badge -->
                                    <Border Width="88" Height="88" CornerRadius="44" Background="#141b2b" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2.5" Margin="0,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="DiagnosticsScoreText" Text="100" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock Text="{loc:Translate Key=Diagnostics.ScoreMax}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                            <TextBlock Text="{loc:Translate Key=Diagnostics.ScoreLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Tier and Summary -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border x:Name="DiagnosticsTierBadge" Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                                <TextBlock x:Name="DiagnosticsTierText" Text="{loc:Translate Key=Diagnostics.TierOptimal}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="DiagnosticsSummaryText" Text="{loc:Translate Key=Diagnostics.SummaryOptimal}"
                                                   FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <Border Style="{StaticResource UiLabelChip}"><TextBlock Text="DirectX / WDA Stealth" FontSize="9.5" Foreground="{StaticResource AccentBrush}"/></Border>
                                            <Border Style="{StaticResource UiLabelChip}"><TextBlock Text="Whisper AVX2 Engine" FontSize="9.5" Foreground="{StaticResource TextDimBrush}"/></Border>
                                            <Border Style="{StaticResource UiLabelChip}"><TextBlock Text="Virtual Desktop COM" FontSize="9.5" Foreground="{StaticResource TextDimBrush}"/></Border>
                                            <Border Style="{StaticResource UiLabelChip}"><TextBlock Text="Loopback Traffic Purge" FontSize="9.5" Foreground="{StaticResource TextDimBrush}"/></Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Hardware Specs Grid (4 Cards) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: CPU -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,5,5">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Path Data="{StaticResource UiIconCpu}" Style="{StaticResource UiStrokeIcon}" Stroke="{StaticResource AccentBrush}" Width="13" Height="13" Margin="0,0,6,0"/>
                                            <TextBlock Text="{loc:Translate Key=Diagnostics.CardCpu}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DiagnosticsCpuName" Text="CPU Processor" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="DiagnosticsCpuCores" Text="Logical Processors" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="DiagnosticsCpuAvx" Text="AI Acceleration" FontSize="10.5" Foreground="{StaticResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: RAM -->
                                <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="5,0,0,5">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Path Data="{StaticResource UiIconFolder}" Style="{StaticResource UiStrokeIcon}" Stroke="{StaticResource AccentBrush}" Width="13" Height="13" Margin="0,0,6,0"/>
                                            <TextBlock Text="{loc:Translate Key=Diagnostics.CardRam}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DiagnosticsRamDetails" Text="RAM Capacity" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
                                        <Grid Margin="0,0,0,3">
                                            <ProgressBar x:Name="DiagnosticsRamProgress" Height="6" Minimum="0" Maximum="100" Value="45" Background="#1c2438" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="DiagnosticsRamLoad" Text="Memory Load %" FontSize="10.5" Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: GPU -->
                                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,5,5,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Path Data="{StaticResource UiIconEye}" Style="{StaticResource UiStrokeIcon}" Stroke="{StaticResource AccentBrush}" Width="13" Height="13" Margin="0,0,6,0"/>
                                            <TextBlock Text="{loc:Translate Key=Diagnostics.CardGpu}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DiagnosticsGpuName" Text="Graphics Card" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="DiagnosticsGpuVram" Text="VRAM" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="DiagnosticsGpuDriver" Text="Driver Version" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: OS & Environment -->
                                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="5,5,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Path Data="{StaticResource UiIconWindows}" Style="{StaticResource UiStrokeIcon}" Stroke="{StaticResource AccentBrush}" Width="13" Height="13" Margin="0,0,6,0"/>
                                            <TextBlock Text="{loc:Translate Key=Diagnostics.CardOs}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DiagnosticsOsVersion" Text="Windows Version" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="DiagnosticsAdminStatus" Text="Privilege Level" FontSize="10.5" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="DiagnosticsStorageInfo" Text="Drive C: Storage" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="DiagnosticsAudioWebViewInfo" Text="Audio &amp; WebView2" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Feature Readiness Matrix -->
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Key=Diagnostics.FeatureMatrixTitle}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                                    <!-- Feature 1: WDA -->
                                    <Border Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource UiIconShield}" Style="{StaticResource UiStrokeIcon}" Stroke="{StaticResource SuccessBrush}" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{loc:Translate Key=Diagnostics.FeatureWda}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock x:Name="TxtWdaDetail" Text="Full stealth capture exclusion supported." FontSize="10" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border x:Name="BadgeWda" Grid.Column="2" Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtWdaStatus" Text="Optimal" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Feature 2: Captions -->
                                    <Border Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource UiIconCaptions}" Style="{StaticResource UiStrokeIcon}" Stroke="{StaticResource SuccessBrush}" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{loc:Translate Key=Diagnostics.FeatureCaptions}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock x:Name="TxtCaptionsDetail" Text="AVX2 acceleration and real-time audio pipeline ready." FontSize="10" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border x:Name="BadgeCaptions" Grid.Column="2" Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtCaptionsStatus" Text="Optimal" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Feature 3: Virtual Desktop -->
                                    <Border Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource UiIconWindows}" Style="{StaticResource UiStrokeIcon}" Stroke="{StaticResource SuccessBrush}" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{loc:Translate Key=Diagnostics.FeatureVd}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock x:Name="TxtVdDetail" Text="IVirtualDesktopManager API active." FontSize="10" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border x:Name="BadgeVd" Grid.Column="2" Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtVdStatus" Text="Optimal" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Feature 4: AI Traffic -->
                                    <Border Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource UiIconLock}" Style="{StaticResource UiStrokeIcon}" Stroke="{StaticResource SuccessBrush}" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{loc:Translate Key=Diagnostics.FeatureAiTraffic}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock x:Name="TxtAiTrafficDetail" Text="Full administrator privileges granted." FontSize="10" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border x:Name="BadgeAiTraffic" Grid.Column="2" Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtAiTrafficStatus" Text="Optimal" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Feature 5: Browser -->
                                    <Border Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource UiIconEye}" Style="{StaticResource UiStrokeIcon}" Stroke="{StaticResource SuccessBrush}" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{loc:Translate Key=Diagnostics.FeatureBrowser}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock x:Name="TxtBrowserDetail" Text="WebView2 Runtime active." FontSize="10" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border x:Name="BadgeBrowser" Grid.Column="2" Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtBrowserStatus" Text="Optimal" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Smart Optimization Recommendations Box -->
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="{StaticResource UiIconAlert}" Style="{StaticResource UiStrokeIcon}" Stroke="{StaticResource AccentBrush}" Width="13" Height="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Translate Key=Diagnostics.RecommendationsTitle}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="DiagnosticsRecommendationsPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Hidden compatibility controls (keeps code-behind working without errors) -->
                <ComboBox x:Name="ProcessCombo" Visibility="Collapsed" Width="0" Height="0" IsHitTestVisible="False"
                          DropDownOpened="ProcessCombo_DropDownOpened" SelectionChanged="ProcessCombo_SelectionChanged"/>
                <Button x:Name="BtnSecureDesktop" Visibility="Collapsed" Width="0" Height="0" Click="BtnSecureDesktop_Click"/>

            </Grid>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             TOAST OVERLAY HOST (Bottom-Right Floating Stack)
             ══════════════════════════════════════════════════════════════ -->
        <StackPanel x:Name="ToastOverlayHost"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Panel.ZIndex="9999"
                    Margin="0,0,20,20">
            <!-- Active Toasts Stack (up to 3 cards) -->
            <StackPanel x:Name="ToastCardsStack" Orientation="Vertical"/>

            <!-- Notification Storm Footer: "+N more notifications" and "Clear All" -->
            <Border x:Name="ToastQueueFooter"
                    Visibility="Collapsed"
                    Background="#f0101726"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtQueueSummary"
                               Text="+1 thông báo khác"
                               Foreground="#94a3b8"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button x:Name="BtnClearAllToasts"
                            Content="{loc:Translate Key=Toast.ClearAll}"
                            Style="{StaticResource BaseButton}"
                            FontSize="10.5"
                            Padding="8,2"
                            Height="24"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══════════════════════════════════════════════════════════════
             DANGER ZONE CONFIRMATION MODAL OVERLAY (Non-Activating)
             ══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="DangerConfirmModalOverlay"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Panel.ZIndex="10000"
              Visibility="Collapsed"
              Background="#B805070E"
              WindowChrome.IsHitTestVisibleInChrome="True"
              MouseLeftButtonDown="DangerConfirmModalBackdrop_MouseLeftButtonDown">
            <Border x:Name="DangerConfirmModalCard"
                    MaxWidth="430"
                    MinWidth="340"
                    Margin="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#111625"
                    BorderBrush="#7f1d1d"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="20,18"
                    MouseLeftButtonDown="DangerConfirmModalCard_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.65"/>
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#361016" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource UiIconAlert}" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="DangerConfirmTitleText"
                                   Grid.Column="1"
                                   Text="{loc:Translate Key=Settings.ConfirmResetTitle}"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="BtnDangerConfirmClose"
                                Grid.Column="2"
                                Style="{StaticResource GhostButton}"
                                Width="24" Height="24" Padding="0"
                                VerticalAlignment="Center"
                                Click="BtnDangerConfirmCancel_Click"
                                ToolTip="{loc:Translate Key=Settings.ConfirmCancel}"
                                AutomationProperties.Name="{loc:Translate Key=Settings.ConfirmCancel}">
                            <Path Data="{StaticResource UiIconClose}" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="10" Height="10"/>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="DangerConfirmMessageText"
                               Text="{loc:Translate Key=Settings.ConfirmResetMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="19"
                               Margin="0,14,0,8"/>

                    <TextBlock Text="{loc:Translate Key=Settings.ConfirmHint}"
                               FontSize="10.5"
                               Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnDangerConfirmCancel"
                                Content="{loc:Translate Key=Settings.ConfirmCancel}"
                                Style="{StaticResource BaseButton}"
                                Padding="14,7"
                                FontSize="11.5"
                                Margin="0,0,10,0"
                                Click="BtnDangerConfirmCancel_Click"/>
                        <Button x:Name="BtnDangerConfirmAccept"
                                Content="{loc:Translate Key=Settings.ConfirmProceed}"
                                Style="{StaticResource DangerButton}"
                                Padding="14,7"
                                FontSize="11.5"
                                Click="BtnDangerConfirmAccept_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
