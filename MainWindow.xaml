                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:RecoveryState.Unverified}">
                                                                        <Setter Property="Background" Value="#30271a"/><Setter Property="BorderBrush" Value="#51422a"/><Setter Property="TextElement.Foreground" Value="#fcd089"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:RecoveryState.Closed}"><Setter Property="TextElement.Foreground" Value="{StaticResource TextMutedBrush}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
